<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {%- if page_title == blank -%}{{ shop.name }}{%- else -%}{{ page_title }} &ndash; {{ shop.name }}{%- endif -%}
    </title>
    <meta name="description" content="{{ page_description | escape }}">

    {%- assign og_title       = page_title | default: shop.name -%}
    {%- assign og_description = page_description | default: shop.description -%}
    {%- assign og_url         = canonical_url | default: request.origin -%}
    {%- if page_image -%}
      {%- assign og_image = page_image | image_url: width: 1200 -%}
    {%- elsif settings.og_image != blank -%}
      {%- assign og_image = settings.og_image | image_url: width: 1200 -%}
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ og_url }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    {%- if template.name == 'product' -%}
      <meta property="og:type" content="product">
      <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency }}">
      <meta property="product:price:currency" content="{{ shop.currency }}">
    {%- else -%}
      <meta property="og:type" content="website">
    {%- endif -%}
    {%- if og_description != blank -%}
      <meta property="og:description" content="{{ og_description | escape }}">
    {%- endif -%}
    {%- if og_image -%}
      <meta property="og:image" content="https:{{ og_image }}">
      <meta property="og:image:width" content="1200">
    {%- endif -%}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    {%- if og_description != blank -%}
      <meta name="twitter:description" content="{{ og_description | escape }}">
    {%- endif -%}
    {%- if og_image -%}
      <meta name="twitter:image" content="https:{{ og_image }}">
    {%- endif -%}

    {%- render 'structured-data' -%}

    <link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any">
    <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <meta name="theme-color" content="#0a0b11">

    {{ content_for_header }}

    {%- if settings.ga4_measurement_id != blank and request.design_mode == false -%}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        // Default everything to denied. Shopify's native Customer Privacy API
        // (window.Shopify.customerPrivacy) is the CMP of record here — it
        // resolves each visitor's actual consent (banner choice, or "allowed"
        // by default in regions where consent isn't legally required) and we
        // mirror that into Consent Mode below, instead of assuming granted.
        // https://shopify.dev/docs/api/customer-privacy
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied'
        });

        // Maps Shopify's consent categories onto Google's Consent Mode
        // signals. Shopify's "marketing" bucket covers ads/targeting, so it
        // drives all three ad_* signals; "analytics" drives analytics_storage.
        function bfSyncConsent(analyticsAllowed, marketingAllowed) {
          gtag('consent', 'update', {
            analytics_storage: analyticsAllowed ? 'granted' : 'denied',
            ad_storage: marketingAllowed ? 'granted' : 'denied',
            ad_user_data: marketingAllowed ? 'granted' : 'denied',
            ad_personalization: marketingAllowed ? 'granted' : 'denied'
          });
        }

        // window.Shopify.customerPrivacy isn't available until explicitly
        // loaded — checking for it directly (without loadFeatures) is always
        // false this early in page load, so the sync below silently never ran.
        if (window.Shopify) {
          window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (error) {
            if (error) return;
            // Returning visitors (or visitors outside a region requiring
            // consent) already have a resolved decision — apply it immediately
            // rather than waiting for visitorConsentCollected, which only
            // fires when consent changes, not on page load.
            bfSyncConsent(
              window.Shopify.customerPrivacy.analyticsProcessingAllowed(),
              window.Shopify.customerPrivacy.marketingAllowed()
            );
          });
        }

        // Fires whenever the shopper accepts/updates consent via Shopify's
        // consent banner (native or app-based) — keeps gtag in sync live.
        document.addEventListener('visitorConsentCollected', function (event) {
          bfSyncConsent(!!event.detail.analyticsAllowed, !!event.detail.marketingAllowed);
        });

        gtag('js', new Date());
        gtag('config', '{{ settings.ga4_measurement_id }}');
        window.bfTrack = function (eventName, params) {
          gtag('event', eventName, params || {});
        };
      </script>
    {%- else -%}
      <script>window.bfTrack = function () {};</script>
    {%- endif -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name | handle }}">

    {% section 'header' %}

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

  </body>
</html>
