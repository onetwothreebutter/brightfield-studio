<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {%- if page_title == blank -%}{{ shop.name }}{%- else -%}{{ page_title }} &ndash; {{ shop.name }}{%- endif -%}
    </title>
    <meta name="description" content="{{ page_description | escape }}">

    {%- assign og_title       = page_title | default: shop.name -%}
    {%- assign og_description = page_description | default: shop.description -%}
    {%- assign og_url         = canonical_url | default: request.origin -%}
    {%- if page_image -%}
      {%- assign og_image = page_image | image_url: width: 1200 -%}
    {%- elsif settings.og_image != blank -%}
      {%- assign og_image = settings.og_image | image_url: width: 1200 -%}
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ og_url }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    <meta property="og:type" content="website">
    {%- if og_description != blank -%}
      <meta property="og:description" content="{{ og_description | escape }}">
    {%- endif -%}
    {%- if og_image -%}
      <meta property="og:image" content="https:{{ og_image }}">
      <meta property="og:image:width" content="1200">
    {%- endif -%}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    {%- if og_description != blank -%}
      <meta name="twitter:description" content="{{ og_description | escape }}">
    {%- endif -%}
    {%- if og_image -%}
      <meta name="twitter:image" content="https:{{ og_image }}">
    {%- endif -%}

    <link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any">
    <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <meta name="theme-color" content="#0a0b11">

    {{ content_for_header }}

    {%- if settings.ga4_measurement_id != blank -%}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{ settings.ga4_measurement_id }}');
        window.bfTrack = function (eventName, params) {
          gtag('event', eventName, params || {});
        };
      </script>
    {%- else -%}
      <script>window.bfTrack = function () {};</script>
    {%- endif -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name | handle }}">

    {% section 'header' %}

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

  </body>
</html>
