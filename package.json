{
  "name": "brightfield-studio",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "push": "shopify theme push --store brightfield-2.myshopify.com --theme 143500345459",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-shaders": "{ sleep 1 && open http://localhost:3001/test-shaders.html; } & npx serve . --listen 3001",
    "palette-viewer": "{ sleep 1 && open http://localhost:3002/palette-viewer.html; } & npx serve . --listen 3002",
    "palette-lab": "{ sleep 1 && open http://localhost:3003/palette-lab.html; } & npx serve . --listen 3003",
    "test:e2e": "playwright test",
    "remove-bg": "node --env-file=worker/.env worker/process-product-images.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
