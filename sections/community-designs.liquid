{%- assign community_col = collections['community-designs'] -%}

<section class="community-designs-section section-padding">
  <div class="container">

    <div class="section-header">
      <h2
        class="section-title glitch"
        data-text="Community Designs"
      >
        Community Designs
      </h2>
    </div>

    {%- if community_col.products.size > 0 -%}
      <div id="community-designs-container" class="product-grid">
        {%- for product in community_col.products limit: 6 -%}
          {%- render 'community-card', product: product -%}
        {%- endfor -%}
      </div>

      <div class="section-footer">
        <a href="{{ pages['community-designs'].url }}" class="btn btn--outline">See All</a>
      </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'community-designs.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.CommunityDesigns) CommunityDesigns.hydrateInteractions();
  });
</script>

{% schema %}
{
  "name": "Community Designs",
  "settings": [],
  "presets": [{ "name": "Community Designs" }]
}
{% endschema %}
