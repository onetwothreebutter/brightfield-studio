<section class="designs-row-section section-padding" id="designs-row-section">
  <div class="container">
    <div class="designs-row__col" id="designs-row__recent">
      <h2 class="recent-designs__heading">Your Recent Designs</h2>
      <div id="recent-designs-container">
        <div class="recent-designs__strip">
          <div class="designs-row__skeleton-card"></div>
          <div class="designs-row__skeleton-card"></div>
          <div class="designs-row__skeleton-card"></div>
          <div class="designs-row__skeleton-card"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'recent-designs.js' | asset_url }}" defer></script>
<script>
(function () {
  var SEE_ALL_MAX = 15;

  function hideSection() {
    var section = document.getElementById('designs-row-section');
    if (section) section.hidden = true;
  }

  function addSeeAllBtn(col, href) {
    var a = document.createElement('a');
    a.href = href;
    a.className = 'designs-row__see-all';
    a.textContent = 'See All';
    col.appendChild(a);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var recentContainer = document.getElementById('recent-designs-container');
    var recentCol = document.getElementById('designs-row__recent');
    if (recentContainer && window.RecentDesigns) {
      RecentDesigns.fetchDesigns().then(function (designs) {
        if (!designs || !designs.length) {
          hideSection();
          return;
        }
        var hasMore = designs.length > SEE_ALL_MAX;
        RecentDesigns.renderFilmstrip(recentContainer, hasMore ? designs.slice(0, SEE_ALL_MAX) : designs);
        if (hasMore) addSeeAllBtn(recentCol, '/pages/recent-designs');
      });
    } else {
      hideSection();
    }
  });
}());
</script>

{% schema %}
{
  "name": "Designs Row",
  "settings": [],
  "presets": [{ "name": "Designs Row" }]
}
{% endschema %}
