{%- assign empty_icon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15l5-5 4 4 3-3 6 6"/><circle cx="8.5" cy="8.5" r="1.5"/></svg>' -%}

<section class="designs-row-section section-padding">
  <div class="container">
    <div class="designs-row">

      <div class="designs-row__col" id="designs-row__recent">
        <h2 class="recent-designs__heading">Your Recent Designs</h2>
        <div id="recent-designs-container">
          <div class="recent-designs__strip">
            <div class="designs-row__skeleton-card"></div>
            <div class="designs-row__skeleton-card"></div>
            <div class="designs-row__skeleton-card"></div>
            <div class="designs-row__skeleton-card"></div>
          </div>
        </div>
      </div>

      <div class="designs-row__col" id="designs-row__community">
        <div class="community-designs__header">
          <h2 class="community-designs__heading">Community Designs</h2>
        </div>
        <div id="community-designs-container">
          <div class="community-designs__strip">
            <div class="designs-row__skeleton-card"></div>
            <div class="designs-row__skeleton-card"></div>
            <div class="designs-row__skeleton-card"></div>
            <div class="designs-row__skeleton-card"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script src="{{ 'recent-designs.js' | asset_url }}" defer></script>
<script src="{{ 'community-designs.js' | asset_url }}" defer></script>
<script>
(function () {
  var EMPTY_ICON = {{ empty_icon | json }};
  var SEE_ALL_MAX = 15;

  function emptyState(message) {
    return '<div class="designs-row__empty">'
      + EMPTY_ICON
      + '<p>' + message + '</p>'
      + '</div>';
  }

  function addSeeAllBtn(col, href) {
    var a = document.createElement('a');
    a.href = href;
    a.className = 'designs-row__see-all';
    a.textContent = 'See All';
    col.appendChild(a);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var recentContainer = document.getElementById('recent-designs-container');
    var recentCol = document.getElementById('designs-row__recent');
    if (recentContainer && window.RecentDesigns) {
      RecentDesigns.fetchDesigns().then(function (designs) {
        if (!designs || !designs.length) {
          recentContainer.innerHTML = emptyState('No saved designs yet');
          return;
        }
        var hasMore = designs.length > SEE_ALL_MAX;
        RecentDesigns.renderFilmstrip(recentContainer, hasMore ? designs.slice(0, SEE_ALL_MAX) : designs);
        if (hasMore) addSeeAllBtn(recentCol, '/pages/recent-designs');
      });
    }

    var communityContainer = document.getElementById('community-designs-container');
    var communityCol = document.getElementById('designs-row__community');
    if (communityContainer && window.CommunityDesigns) {
      CommunityDesigns.fetchCommunityDesigns().then(function (designs) {
        if (!designs || !designs.length) {
          communityContainer.innerHTML = emptyState('No community designs yet');
          return;
        }
        var hasMore = designs.length > SEE_ALL_MAX;
        CommunityDesigns.renderStrip(communityContainer, hasMore ? designs.slice(0, SEE_ALL_MAX) : designs, {
          getDeviceId: window.RecentDesigns && window.RecentDesigns.getDeviceId
        });
        if (hasMore) addSeeAllBtn(communityCol, '/pages/community-designs');
      });
    }
  });
}());
</script>

{% schema %}
{
  "name": "Designs Row",
  "settings": [],
  "presets": [{ "name": "Designs Row" }]
}
{% endschema %}
