<footer class="site-footer" role="contentinfo">
  <div class="container">

    <div class="footer-top">
      <a href="{{ routes.root_url }}" class="footer-logo">
        {%- render 'wordmark' -%}
      </a>

      <nav aria-label="Footer navigation">
        <ul class="footer-nav__list">
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          {%- if shop.refund_policy -%}
            <li><a href="{{ shop.refund_policy.url }}">Returns</a></li>
          {%- endif -%}
          {%- if section.settings.instagram != blank -%}
            <li><a href="{{ section.settings.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      {%- if shop.privacy_policy or shop.shipping_policy or shop.terms_of_service -%}
        <ul class="footer-legal">
          {%- if shop.privacy_policy -%}
            <li><a href="{{ shop.privacy_policy.url }}">Privacy</a></li>
          {%- endif -%}
          {%- if shop.shipping_policy -%}
            <li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>
          {%- endif -%}
          {%- if shop.terms_of_service -%}
            <li><a href="{{ shop.terms_of_service.url }}">Terms of Service</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
      {%- if shop.email != blank or section.settings.location_text != blank -%}
        <p class="footer-business">
          {%- if shop.email != blank -%}
            <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
          {%- endif -%}
          {%- if shop.email != blank and section.settings.location_text != blank -%}
            <span aria-hidden="true"> &middot; </span>
          {%- endif -%}
          {%- if section.settings.location_text != blank -%}
            {{ section.settings.location_text }}
          {%- endif -%}
        </p>
      {%- endif -%}
      <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "location_text",
      "label": "Location / business identity",
      "info": "Shown next to the contact email in the footer, e.g. \"Designed in Bend, OR\"."
    }
  ]
}
{% endschema %}
