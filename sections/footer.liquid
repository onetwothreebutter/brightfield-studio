<footer class="site-footer" role="contentinfo">
  <div class="container">

    <div class="footer-grid">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="footer-logo">{{ shop.name }}</a>
        {%- if section.settings.tagline != blank -%}
          <p class="footer-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-nav__column">
          <h3 class="footer-nav__heading">Customer Care</h3>
          <ul class="footer-nav__list">
            <li><a href="/pages/contact">Contact</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            {%- if shop.shipping_policy -%}
              <li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>
            {%- endif -%}
            {%- if shop.refund_policy -%}
              <li><a href="{{ shop.refund_policy.url }}">Returns</a></li>
            {%- endif -%}
            <li><a href="/pages/faq#size-guide">Size Guide</a></li>
          </ul>
        </div>

        <div class="footer-nav__column">
          <h3 class="footer-nav__heading">About</h3>
          <ul class="footer-nav__list">
            <li><a href="/pages/about">About Brightfield</a></li>
            <li><a href="/pages/about#how-it-works">How It Works</a></li>
            <li><a href="/pages/community-designs">Community</a></li>
          </ul>
        </div>

        {%- if shop.privacy_policy or shop.terms_of_service -%}
          <div class="footer-nav__column">
            <h3 class="footer-nav__heading">Legal</h3>
            <ul class="footer-nav__list">
              {%- if shop.privacy_policy -%}
                <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
              {%- endif -%}
              {%- if shop.terms_of_service -%}
                <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.instagram != blank -%}
          <div class="footer-nav__column">
            <h3 class="footer-nav__heading">Follow</h3>
            <ul class="footer-nav__list">
              <li><a href="{{ section.settings.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a></li>
            </ul>
          </div>
        {%- endif -%}
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      {%- if shop.email != blank or section.settings.location_text != blank -%}
        <p class="footer-business">
          {%- if shop.email != blank -%}
            <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
          {%- endif -%}
          {%- if shop.email != blank and section.settings.location_text != blank -%}
            <span aria-hidden="true"> &middot; </span>
          {%- endif -%}
          {%- if section.settings.location_text != blank -%}
            {{ section.settings.location_text }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Art rendered in silicon. Worn on skin."
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "location_text",
      "label": "Location / business identity",
      "info": "Shown next to the contact email in the footer, e.g. \"Designed in Bend, OR\"."
    }
  ]
}
{% endschema %}
