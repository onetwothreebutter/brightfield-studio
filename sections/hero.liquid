<section class="hero">
  <picture>
    <source media="(max-width: 768px)" srcset="{{ 'hero-poster-mobile.webp' | asset_url }}">
    <img id="hero-poster" class="hero__poster" aria-hidden="true" alt=""
      src="{{ 'hero-poster.webp' | asset_url }}">
  </picture>
  <div class="hero__scrim" aria-hidden="true"></div>
  <canvas id="hero-shader-canvas" class="hero__canvas" aria-hidden="true"></canvas>

  <div class="hero__content container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1
      class="hero__title glitch"
      data-text="{{ section.settings.heading | default: shop.name | escape }}"
    >
      {{ section.settings.heading | default: shop.name | escape }}
    </h1>

    {%- if section.settings.subheading != blank -%}
      <p class="hero__subtitle">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_url != blank or section.settings.cta2_url != blank -%}
      <div class="hero__ctas">
        {%- if section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--primary btn--lg">
            {{ section.settings.cta_label | default: 'Shop the Collection' | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_url != blank -%}
          <a href="{{ section.settings.cta2_url }}" class="btn btn--outline btn--lg">
            {{ section.settings.cta2_label | default: 'Make it Yours' | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>

<script src="{{ 'hero-shader.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Wearable Shader Art"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use store name"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "T-shirts generated from WebGL shaders. Every design is a living program."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Second button label",
      "default": "Make it Yours"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
