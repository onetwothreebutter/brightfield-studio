// ── Desktop: lock controls height to canvas height ────────────────────────────
(function () {
  if (!window.ResizeObserver) return;
  if (window.innerWidth <= 800) return;
  var canvasWrap = document.querySelector('.shader-demo__canvas-wrap');
  var controls   = document.querySelector('.shader-demo__controls');
