            });
            window.location.href = '/cart';
          });
        })
        .catch(function (err) {
          window.bfTrack('add_to_cart_failure', { location: 'homepage_demo', shader: PRODUCT_HANDLE, error: err.message });
          alert('Could not add to cart: ' + err.message);
