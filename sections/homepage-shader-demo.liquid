    window._demoState.dirty = true;
  });

  paletteAInput.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_palette_a = hexToRgb(this.value);
    window._demoState.dirty = true;
  });
  paletteBInput.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_palette_b = hexToRgb(this.value);
    window._demoState.dirty = true;
  });
  paletteCInput.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_palette_c = hexToRgb(this.value);
    window._demoState.dirty = true;
  });
  paletteDInput.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_palette_d = hexToRgb(this.value);
    window._demoState.dirty = true;
  });

  color0Input.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_color0 = hexToRgb(this.value);
    window._demoState.dirty = true;
  });
  color1Input.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_color1 = hexToRgb(this.value);
    window._demoState.dirty = true;
  });
  color2Input.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_color2 = hexToRgb(this.value);
    window._demoState.dirty = true;
  });
  color3Input.addEventListener('input', function () {
    onUserInteract();
    window._demoState.values.u_color3 = hexToRgb(this.value);
    window._demoState.dirty = true;
  });

  // ── Control wiring ─────────────────────────────────────────────────────────
  presetSel.addEventListener('change', function () {
    onUserInteract();
    applyPreset(this.value);
  });

  lineCountInput.addEventListener('input', function () {
    onUserInteract();
    applyLineCount(parseInt(this.value, 10));
  });

  powerInput.addEventListener('input', function () {
    onUserInteract();
    applyPower(parseFloat(this.value));
  });

  centerCircleInput.addEventListener('input', function () {
    onUserInteract();
