<section class="shader-demo" id="shader-demo">
  <div class="shader-demo__header container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="shader-demo__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="shader-demo__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="shader-demo__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="shader-demo__body container">
    <div class="shader-demo__canvas-wrap">
      <canvas id="demo-shader-canvas" class="shader-demo__canvas" aria-hidden="true"></canvas>
    </div>

    <div class="shader-demo__controls">

      <div class="scroll-shadow scroll-shadow--top" aria-hidden="true"></div>

      <!-- Randomize -->
      <button type="button" class="shader-control__randomize-btn" id="demo-randomize">Randomize</button>

      <!-- Cycle indicator dots -->
      <div class="shader-demo__cycle-indicator" id="demo-cycle-dots" aria-hidden="true"></div>

      <!-- Color Palette -->
      <div class="shader-control">
        <label class="shader-control__label">Color Palette</label>
        <select class="shader-control__select" id="demo-preset">
          <optgroup label="Cosine">
            <option value="Rainbow">Rainbow</option>
            <option value="Cool Blue">Cool Blue</option>
            <option value="Neon Heat">Neon Heat</option>
            <option value="Cyberpunk">Cyberpunk</option>
            <option value="Golden">Golden</option>
            <option value="Synthwave">Synthwave</option>
            <option value="Pastel">Pastel</option>
            <option value="Arctic">Arctic</option>
            <option value="Mexican">Mexican</option>
            <option value="Inferno">Inferno</option>
            <option value="Ocean">Ocean</option>
            <option value="Vaporwave">Vaporwave</option>
            <option value="Acid">Acid</option>
            <option value="Warm Earth">Warm Earth</option>
            <option value="Violet">Violet</option>
            <option value="Coral Reef">Coral Reef</option>
            <option value="Sakura">Sakura</option>
            <option value="Terracotta">Terracotta</option>
            <option value="Lavender Field">Lavender Field</option>
            <option value="Bioluminescent">Bioluminescent</option>
            <option value="Holographic">Holographic</option>
          </optgroup>
          <optgroup label="4-Color">
            <option value="Neon">Neon</option>
            <option value="Retro">Retro</option>
            <option value="Sunset">Sunset</option>
            <option value="Aurora">Aurora</option>
            <option value="Dusk">Dusk</option>
            <option value="Midnight">Midnight</option>
            <option value="Ember">Ember</option>
            <option value="Obsidian">Obsidian</option>
            <option value="Velvet">Velvet</option>
            <option value="Mexican 4C">Mexican</option>
            <option value="Viridis">Viridis</option>
            <option value="Teal & Orange">Teal &amp; Orange</option>
            <option value="Ice Cream">Ice Cream</option>
            <option value="Jamaica">Jamaica</option>
          </optgroup>
        </select>
      </div>

      <!-- Lines -->
      <div class="shader-control">
        <label class="shader-control__label">Lines</label>
        <div class="shader-control__range-wrap">
          <input type="range" class="shader-control__range" id="demo-line-count" min="2" max="80" step="1" value="20">
          <span class="shader-control__value" id="demo-line-count-display">20</span>
        </div>
      </div>

      <!-- Power -->
      <div class="shader-control">
        <label class="shader-control__label">Power</label>
        <div class="shader-control__range-wrap">
          <input type="range" class="shader-control__range" id="demo-power" min="0.5" max="6.0" step="0.1" value="2.5">
          <span class="shader-control__value" id="demo-power-display">2.5</span>
        </div>
      </div>

      <!-- Center Circle -->
      <div class="shader-control">
        <label class="shader-control__label">Center Circle</label>
        <div class="shader-control__range-wrap">
          <input type="range" class="shader-control__range" id="demo-center-circle" min="0.01" max="0.45" step="0.005" value="0.04">
          <span class="shader-control__value" id="demo-center-circle-display">0.04</span>
        </div>
      </div>

      <!-- All Settings (collapsible) -->
      <div class="shader-demo__all-settings">
        <button type="button" class="shader-demo__all-settings-toggle" id="demo-all-settings-toggle" aria-expanded="false">
          All Settings
          <span class="shader-demo__all-settings-chevron" aria-hidden="true">&#9660;</span>
        </button>
        <div class="shader-demo__all-settings-body" id="demo-all-settings-body" hidden>

          <p class="shader-demo__panel-label">Shape</p>

          <!-- Radius -->
          <div class="shader-control">
            <label class="shader-control__label">Radius</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-radius" min="0.05" max="0.5" step="0.01" value="0.4">
              <span class="shader-control__value" id="demo-radius-display">0.4</span>
            </div>
          </div>

          <!-- Width Top -->
          <div class="shader-control">
            <label class="shader-control__label">Width Top</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-width-top" min="0" max="1" step="0.01" value="0.05">
              <span class="shader-control__value" id="demo-width-top-display">0.05</span>
            </div>
          </div>

          <!-- Width Bottom -->
          <div class="shader-control">
            <label class="shader-control__label">Width Bottom</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-width-bot" min="0" max="1" step="0.01" value="0.75">
              <span class="shader-control__value" id="demo-width-bot-display">0.75</span>
            </div>
          </div>

          <p class="shader-demo__panel-label">Color Palette</p>

          <!-- Color Mode -->
          <div class="shader-control">
            <label class="shader-control__label">Color Mode</label>
            <div class="shader-control__with-help">
              <select class="shader-control__select" id="demo-color-mode">
                <option value="0">Cosine</option>
                <option value="1">4-Color</option>
              </select>
              <button type="button" class="shader-demo__help-btn" id="demo-cosine-help" aria-label="About cosine palette">?</button>
            </div>
          </div>

          <!-- Cosine Preset -->
          <div class="shader-control" id="demo-cosine-preset-row">
            <label class="shader-control__label">Preset</label>
            <select class="shader-control__select" id="demo-cosine-preset">
              <option value="Rainbow">Rainbow</option>
              <option value="Cool Blue">Cool Blue</option>
              <option value="Neon Heat">Neon Heat</option>
              <option value="Cyberpunk">Cyberpunk</option>
              <option value="Golden">Golden</option>
              <option value="Synthwave">Synthwave</option>
              <option value="Pastel">Pastel</option>
              <option value="Arctic">Arctic</option>
              <option value="Mexican">Mexican</option>
              <option value="Inferno">Inferno</option>
              <option value="Ocean">Ocean</option>
              <option value="Vaporwave">Vaporwave</option>
              <option value="Acid">Acid</option>
              <option value="Warm Earth">Warm Earth</option>
              <option value="Violet">Violet</option>
              <option value="Coral Reef">Coral Reef</option>
              <option value="Sakura">Sakura</option>
              <option value="Terracotta">Terracotta</option>
              <option value="Lavender Field">Lavender Field</option>
              <option value="Bioluminescent">Bioluminescent</option>
              <option value="Holographic">Holographic</option>
            </select>
          </div>

          <!-- 4-Color Preset -->
          <div class="shader-control" id="demo-stop-preset-row" style="display:none">
            <label class="shader-control__label">Preset</label>
            <select class="shader-control__select" id="demo-stop-preset">
              <option value="Neon">Neon</option>
              <option value="Retro">Retro</option>
              <option value="Sunset">Sunset</option>
              <option value="Aurora">Aurora</option>
              <option value="Dusk">Dusk</option>
              <option value="Midnight">Midnight</option>
              <option value="Ember">Ember</option>
              <option value="Obsidian">Obsidian</option>
              <option value="Velvet">Velvet</option>
              <option value="Mexican 4C">Mexican</option>
              <option value="Viridis">Viridis</option>
              <option value="Teal & Orange">Teal &amp; Orange</option>
              <option value="Ice Cream">Ice Cream</option>
              <option value="Jamaica">Jamaica</option>
            </select>
          </div>

          <!-- Palette A -->
          <div class="shader-control" id="demo-palette-a-row">
            <label class="shader-control__label">Palette A</label>
            <input type="color" class="shader-control__color" id="demo-palette-a" value="#808080">
          </div>

          <!-- Palette B -->
          <div class="shader-control" id="demo-palette-b-row">
            <label class="shader-control__label">Palette B</label>
            <input type="color" class="shader-control__color" id="demo-palette-b" value="#808080">
          </div>

          <!-- Palette C -->
          <div class="shader-control" id="demo-palette-c-row">
            <label class="shader-control__label">Palette C</label>
            <input type="color" class="shader-control__color" id="demo-palette-c" value="#ffffff">
          </div>

          <!-- Palette D -->
          <div class="shader-control" id="demo-palette-d-row">
            <label class="shader-control__label">Palette D</label>
            <input type="color" class="shader-control__color" id="demo-palette-d" value="#0054ab">
          </div>

          <!-- Color 1 (Top) -->
          <div class="shader-control" id="demo-color0-row" style="display:none">
            <label class="shader-control__label">Color 1 (Top)</label>
            <input type="color" class="shader-control__color" id="demo-color0" value="#ff3366">
          </div>

          <!-- Color 2 -->
          <div class="shader-control" id="demo-color1-row" style="display:none">
            <label class="shader-control__label">Color 2</label>
            <input type="color" class="shader-control__color" id="demo-color1" value="#ffcc00">
          </div>

          <!-- Color 3 -->
          <div class="shader-control" id="demo-color2-row" style="display:none">
            <label class="shader-control__label">Color 3</label>
            <input type="color" class="shader-control__color" id="demo-color2" value="#00ccff">
          </div>

          <!-- Color 4 (Bot) -->
          <div class="shader-control" id="demo-color3-row" style="display:none">
            <label class="shader-control__label">Color 4 (Bot)</label>
            <input type="color" class="shader-control__color" id="demo-color3" value="#aa00ff">
          </div>

          <p class="shader-demo__panel-label">Triangle Mask</p>

          <!-- Triangle Enabled -->
          <div class="shader-control">
            <label class="shader-control__label">Enabled</label>
            <button type="button" class="shader-control__toggle is-on" id="demo-tri-enabled" data-on="1">On</button>
          </div>

          <!-- Triangle Rotation -->
          <div class="shader-control">
            <label class="shader-control__label">Rotation (°)</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-tri-rotation" min="0" max="360" step="1" value="0">
              <span class="shader-control__value" id="demo-tri-rotation-display">0</span>
            </div>
          </div>

          <!-- Triangle Size -->
          <div class="shader-control">
            <label class="shader-control__label">Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-tri-size" min="0.1" max="2.0" step="0.01" value="1.0">
              <span class="shader-control__value" id="demo-tri-size-display">1</span>
            </div>
          </div>

          <!-- Triangle Base Width -->
          <div class="shader-control">
            <label class="shader-control__label">Base Width (°)</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-tri-width" min="5" max="89" step="1" value="45">
              <span class="shader-control__value" id="demo-tri-width-display">45</span>
            </div>
          </div>

          <p class="shader-demo__panel-label">Center Circle</p>

          <!-- Center Circle Enabled -->
          <div class="shader-control">
            <label class="shader-control__label">Enabled</label>
            <button type="button" class="shader-control__toggle is-on" id="demo-center-circle-enabled" data-on="1">On</button>
          </div>

          <p class="shader-demo__panel-label">Text Overlay</p>

          <!-- Enable Text -->
          <div class="shader-control">
            <label class="shader-control__label">Enable Text</label>
            <button type="button" class="shader-control__toggle" id="demo-enable-text" data-on="0">Off</button>
          </div>

          <!-- Text -->
          <div class="shader-control">
            <label class="shader-control__label">Text</label>
            <input type="text" class="shader-control__text-input" id="demo-text" value="{{ 'now' | date: '%Y' }}" placeholder="Your text">
          </div>

          <!-- Font -->
          <div class="shader-control">
            <label class="shader-control__label">Font</label>
            <select class="shader-control__select" id="demo-text-font">
              <option value="Space Mono">Space Mono</option>
              <option value="Roboto Mono">Roboto Mono</option>
              <option value="Source Code Pro">Source Code Pro</option>
              <option value="JetBrains Mono">JetBrains Mono</option>
              <option value="IBM Plex Mono">IBM Plex Mono</option>
              <option value="Fira Code">Fira Code</option>
              <option value="Inconsolata">Inconsolata</option>
              <option value="Courier Prime">Courier Prime</option>
              <option value="Share Tech Mono">Share Tech Mono</option>
              <option value="Cutive Mono">Cutive Mono</option>
              <option value="DM Mono">DM Mono</option>
              <option value="Fragment Mono">Fragment Mono</option>
              <option value="Azeret Mono">Azeret Mono</option>
              <option value="Spline Sans Mono">Spline Sans Mono</option>
              <option value="Geist Mono">Geist Mono</option>
              <option value="Syne">Syne</option>
              <option value="Unbounded">Unbounded</option>
              <option value="Bricolage Grotesque">Bricolage Grotesque</option>
              <option value="Epilogue">Epilogue</option>
              <option value="DM Sans">DM Sans</option>
              <option value="Oswald" selected>Oswald</option>
              <option value="Montserrat">Montserrat</option>
              <option value="Bebas Neue">Bebas Neue</option>
              <option value="Barlow Condensed">Barlow Condensed</option>
              <option value="Anton">Anton</option>
              <option value="Fjalla One">Fjalla One</option>
            </select>
          </div>

          <!-- Font Size -->
          <div class="shader-control">
            <label class="shader-control__label">Font Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-text-size" min="8" max="300" step="1" value="69">
              <span class="shader-control__value" id="demo-text-size-display">69</span>
            </div>
          </div>

          <!-- Text X -->
          <div class="shader-control">
            <label class="shader-control__label">Text X</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-text-x" min="0" max="1" step="0.01" value="0.3">
              <span class="shader-control__value" id="demo-text-x-display">0.3</span>
            </div>
          </div>

          <!-- Text Y -->
          <div class="shader-control">
            <label class="shader-control__label">Text Y</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-text-y" min="0" max="1" step="0.01" value="0.2">
              <span class="shader-control__value" id="demo-text-y-display">0.2</span>
            </div>
          </div>

          <!-- Custom Text Color -->
          <div class="shader-control">
            <label class="shader-control__label">Custom Color</label>
            <button type="button" class="shader-control__toggle" id="demo-use-text-color" data-on="0">Off</button>
          </div>

          <!-- Text Color -->
          <div class="shader-control" id="demo-text-color-row" style="display:none">
            <label class="shader-control__label">Text Color</label>
            <input type="color" class="shader-control__color" id="demo-text-color" value="#ffffff">
          </div>

          <!-- Outline -->
          <div class="shader-control">
            <label class="shader-control__label">Outline</label>
            <button type="button" class="shader-control__toggle" id="demo-outline-enabled" data-on="0">Off</button>
          </div>

          <!-- Outline Width -->
          <div class="shader-control" id="demo-outline-width-row" style="display:none">
            <label class="shader-control__label">Outline Width</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-outline-width" min="1" max="60" step="1" value="8">
              <span class="shader-control__value" id="demo-outline-width-display">8</span>
            </div>
          </div>

          <!-- Outline Color -->
          <div class="shader-control" id="demo-outline-color-row" style="display:none">
            <label class="shader-control__label">Outline Color</label>
            <input type="color" class="shader-control__color" id="demo-outline-color" value="#000000">
          </div>

          <p class="shader-demo__panel-label">Finish</p>

          <!-- Opacity -->
          <div class="shader-control">
            <label class="shader-control__label">Opacity</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-opacity" min="0" max="1" step="0.01" value="1">
              <span class="shader-control__value" id="demo-opacity-display">1</span>
            </div>
          </div>

          <!-- Grain Type -->
          <div class="shader-control">
            <label class="shader-control__label">Grain Type</label>
            <select class="shader-control__select" id="demo-grain-mode">
              <option value="0">Organic</option>
              <option value="1">Blue Noise</option>
              <option value="2">Scratches</option>
              <option value="3">Crosshatch</option>
              <option value="4">Half-tone</option>
            </select>
          </div>

          <!-- Grain 0: Organic -->
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--0">
            <label class="shader-control__label">Amount</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-0" min="0" max="0.85" step="0.01" value="0">
              <span class="shader-control__value" id="demo-distress-0-display">0</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--0">
            <label class="shader-control__label">Blob Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-scale-0" min="10" max="600" step="1" value="80">
              <span class="shader-control__value" id="demo-distress-scale-0-display">80</span>
            </div>
          </div>

          <!-- Grain 1: Blue Noise -->
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--1" style="display:none">
            <label class="shader-control__label">Amount</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-1" min="0" max="0.85" step="0.01" value="0">
              <span class="shader-control__value" id="demo-distress-1-display">0</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--1" style="display:none">
            <label class="shader-control__label">Dot Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-scale-1" min="10" max="600" step="1" value="80">
              <span class="shader-control__value" id="demo-distress-scale-1-display">80</span>
            </div>
          </div>

          <!-- Grain 2: Scratches -->
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--2" style="display:none">
            <label class="shader-control__label">Amount</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-2" min="0" max="0.85" step="0.01" value="0">
              <span class="shader-control__value" id="demo-distress-2-display">0</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--2" style="display:none">
            <label class="shader-control__label">Line Density</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-scale-2" min="10" max="600" step="1" value="80">
              <span class="shader-control__value" id="demo-distress-scale-2-display">80</span>
            </div>
          </div>

          <!-- Grain 3: Crosshatch -->
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--3" style="display:none">
            <label class="shader-control__label">Amount</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-3" min="0" max="0.85" step="0.01" value="0">
              <span class="shader-control__value" id="demo-distress-3-display">0</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--3" style="display:none">
            <label class="shader-control__label">Line Density</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-scale-3" min="10" max="600" step="1" value="80">
              <span class="shader-control__value" id="demo-distress-scale-3-display">80</span>
            </div>
          </div>

          <!-- Grain 4: Half-tone -->
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--4" style="display:none">
            <label class="shader-control__label">Amount</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-4" min="0" max="0.85" step="0.01" value="0.42">
              <span class="shader-control__value" id="demo-distress-4-display">0.42</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--4" style="display:none">
            <label class="shader-control__label">Dot Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-distress-scale-4" min="10" max="600" step="1" value="91">
              <span class="shader-control__value" id="demo-distress-scale-4-display">91</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--4" style="display:none">
            <label class="shader-control__label">Angle</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-halftone-angle" min="0" max="180" step="1" value="45">
              <span class="shader-control__value" id="demo-halftone-angle-display">45</span>
            </div>
          </div>
          <div class="shader-control shader-control--indented demo-grain-row demo-grain-row--4" style="display:none">
            <label class="shader-control__label">Luma Drive</label>
            <div class="shader-control__range-wrap">
