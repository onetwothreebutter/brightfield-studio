  // ── Cycle dots ─────────────────────────────────────────────────────────────
  CYCLE_STEPS.forEach(function () {
    var dot = document.createElement('span');
    dot.className = 'shader-demo__cycle-dot';
    dotsWrap.appendChild(dot);
  });
  var dots = dotsWrap.querySelectorAll('.shader-demo__cycle-dot');

  function setActiveDot(index) {
    dots.forEach(function (d, i) {
      d.classList.toggle('is-active', i === index);
    });
  }

  // ── Apply helpers ──────────────────────────────────────────────────────────
  function setMode(mode) {
    window._demoState.values.u_color_mode = mode;
  }

  function applyPreset(name) {
    var p = PRESETS[name];
    if (!p) return;
    var v = window._demoState.values;
    setMode(p.mode);
    if (p.mode === 0) {
      v.u_palette_a = p.a; v.u_palette_b = p.b; v.u_palette_c = p.c; v.u_palette_d = p.d;
      if (paletteAInput) paletteAInput.value = rgbToHex(p.a);
      if (paletteBInput) paletteBInput.value = rgbToHex(p.b);
      if (paletteCInput) paletteCInput.value = rgbToHex(p.c);
      if (paletteDInput) paletteDInput.value = rgbToHex(p.d);
    } else {
      v.u_color0 = p.c0; v.u_color1 = p.c1;
      v.u_color2 = p.c2; v.u_color3 = p.c3;
      if (color0Input) color0Input.value = rgbToHex(p.c0);
      if (color1Input) color1Input.value = rgbToHex(p.c1);
      if (color2Input) color2Input.value = rgbToHex(p.c2);
      if (color3Input) color3Input.value = rgbToHex(p.c3);
    }
    if (colorModeSel) {
      colorModeSel.value = String(p.mode);
      applyColorModeVisibility();
    }
    presetSel.value = name;
    window._demoState.dirty = true;
  }

  function applyLineCount(n) {
    window._demoState.values.u_line_count = n;
    lineCountInput.value         = n;
    lineCountDisp.textContent    = n;
    window._demoState.dirty = true;
  }

  function applyPower(p) {
    window._demoState.values.u_power = p;
    powerInput.value      = p;
    powerDisp.textContent = p;
    window._demoState.dirty = true;
  }

  function applyCenterCircle(r) {
    window._demoState.values.u_center_circle_radius = r;
    centerCircleInput.value      = r;
    centerCircleDisp.textContent = r;
    window._demoState.dirty = true;
  }

  // ── Auto-cycle ─────────────────────────────────────────────────────────────
  var cycleIndex    = 0;
  var cycleTimer    = null;
  var userInteracted = false;

  function applyStep(index) {
    var step = CYCLE_STEPS[index];
    applyPreset(step.preset);
    applyLineCount(step.lineCount);
    applyPower(step.power);
    applyCenterCircle(step.centerCircle);
    setActiveDot(index);
  }

  function startCycle() {
    applyStep(0);
    cycleTimer = setInterval(function () {
      cycleIndex = (cycleIndex + 1) % CYCLE_STEPS.length;
      applyStep(cycleIndex);
    }, CYCLE_INTERVAL_MS);
  }

  function stopCycle() {
    if (cycleTimer) { clearInterval(cycleTimer); cycleTimer = null; }
    dotsWrap.style.display = 'none';
  }

  function hexToRgb(hex) {
    return [
      parseInt(hex.slice(1, 3), 16) / 255,
      parseInt(hex.slice(3, 5), 16) / 255,
      parseInt(hex.slice(5, 7), 16) / 255,
    ];
  }

  function rgbToHex(arr) {
    return '#' + arr.map(function (x) {
      var b = Math.round(Math.max(0, Math.min(1, x)) * 255).toString(16);
      return b.length === 1 ? '0' + b : b;
    }).join('');
  }

  function applyColorModeVisibility() {
    var is4Color = colorModeSel && colorModeSel.value === '1';
    paletteRows.forEach(function (r) { if (r) r.style.display = is4Color ? 'none' : 'grid'; });
    stopRows.forEach(function (r)    { if (r) r.style.display = is4Color ? 'grid' : 'none'; });
  }

  function onUserInteract() {
    if (userInteracted) return;
    userInteracted = true;
    stopCycle();
  }

  // ── All Settings toggle ────────────────────────────────────────────────────
  if (allSettingsToggle && allSettingsBody) {
    allSettingsToggle.addEventListener('click', function () {
      var isOpen = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      allSettingsBody.hidden = isOpen;
    });
  }

  // ── Cosine help modal ──────────────────────────────────────────────────────
  function openCosineModal()  { if (cosineModal) cosineModal.classList.remove('shader-demo__help-modal--hidden'); }
  function closeCosineModal() { if (cosineModal) cosineModal.classList.add('shader-demo__help-modal--hidden'); }
  if (cosineHelpBtn)  cosineHelpBtn.addEventListener('click', openCosineModal);
  if (cosineClose)    cosineClose.addEventListener('click', closeCosineModal);
  if (cosineBackdrop) cosineBackdrop.addEventListener('click', closeCosineModal);

  // ── All Settings control wiring ────────────────────────────────────────────
  radiusInput.addEventListener('input', function () {
    onUserInteract();
    var n = parseFloat(this.value);
    window._demoState.values.u_radius = n;
    radiusDisp.textContent = n;
    window._demoState.dirty = true;
  });

  widthTopInput.addEventListener('input', function () {
