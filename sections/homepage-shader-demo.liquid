  });

  triWidthInput.addEventListener('input', function () {
    onUserInteract();
    var n = parseInt(this.value, 10);
    window._demoState.values.u_tri_width = n;
    triWidthDisp.textContent = n;
    window._demoState.dirty = true;
  });

  centerCircleEnabledBtn.addEventListener('click', function () {
    onUserInteract();
    var isOn = this.dataset.on === '1';
    var next = isOn ? 0 : 1;
    window._demoState.values.u_center_circle_enabled = next;
    this.dataset.on  = next ? '1' : '0';
    this.textContent = next ? 'On' : 'Off';
    this.classList.toggle('is-on', !!next);
