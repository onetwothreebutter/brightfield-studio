// ── Desktop: scroll shadows on controls ───────────────────────────────────────
(function () {
  var el = document.querySelector('.shader-demo__controls');
  if (!el) return;
  function update() {
    el.classList.toggle('is-scrollable-top',    el.scrollTop > 4);
    el.classList.toggle('is-scrollable-bottom', el.scrollTop + el.clientHeight < el.scrollHeight - 4);
  }
  el.addEventListener('scroll', function onFirstScroll() {
    el.classList.add('has-scrolled');
    el.removeEventListener('scroll', onFirstScroll);
  }, { passive: true });
  el.addEventListener('scroll', update, { passive: true });
  if (window.ResizeObserver) { new ResizeObserver(update).observe(el); }
  update();
}());

// ── Mobile: fade controls as they scroll past the canvas bottom ───────────────
(function () {
  if (window.innerWidth > 800) return;
  var canvasWrap    = document.querySelector('.shader-demo__canvas-wrap');
  var controlsEl    = document.querySelector('.shader-demo__controls');
  var allSettingsEl = document.querySelector('.shader-demo__all-settings');
  if (!canvasWrap || !controlsEl) return;

  var FADE_ZONE = 72; // px — rows fade over this distance approaching canvas bottom

  function fadeRow(el, canvasBottom) {
    if (el.style.display === 'none') return;
    var rect    = el.getBoundingClientRect();
    var rowMid  = (rect.top + rect.bottom) / 2;
    var dist    = rowMid - canvasBottom;
    var opacity = dist <= 0 ? 0 : dist < FADE_ZONE ? dist / FADE_ZONE : 1;
    el.style.opacity       = opacity;
    el.style.pointerEvents = opacity < 0.15 ? 'none' : '';
  }

  function updateFade() {
    var canvasBottom = canvasWrap.getBoundingClientRect().bottom;
    var children = controlsEl.children;
    for (var i = 0; i < children.length; i++) {
      var child = children[i];
      if (child === allSettingsEl) {
        // Fade the toggle button as its own row
        var toggle = child.querySelector('.shader-demo__all-settings-toggle');
        if (toggle) fadeRow(toggle, canvasBottom);
        // Fade each row in the body individually when expanded
        var body = child.querySelector('.shader-demo__all-settings-body');
        if (body && !body.hidden) {
          for (var j = 0; j < body.children.length; j++) {
            fadeRow(body.children[j], canvasBottom);
          }
        }
      } else {
        fadeRow(child, canvasBottom);
      }
    }
  }

  window.addEventListener('scroll', updateFade, { passive: true });
  updateFade();

  // ── Analytics: generic control-change tracking (delegated, fires once per completed interaction) ──
  var demoControlsEl = document.querySelector('.shader-demo__controls');
  if (demoControlsEl) {
    demoControlsEl.addEventListener('change', function (e) {
      var t = e.target;
      if (t.tagName !== 'SELECT' && t.tagName !== 'INPUT') return;
      window.bfTrack('shader_demo_control_change', { control: t.id || t.dataset.paramKey || t.className });
    });
  }
}());
</script>

