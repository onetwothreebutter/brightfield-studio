<section class="shader-demo">
  <div class="shader-demo__header container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="shader-demo__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="shader-demo__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="shader-demo__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="shader-demo__body container">
    <div class="shader-demo__canvas-wrap">
      <canvas id="demo-shader-canvas" class="shader-demo__canvas" aria-hidden="true"></canvas>
    </div>

    <div class="shader-demo__controls">

      <!-- Cycle indicator dots -->
      <div class="shader-demo__cycle-indicator" id="demo-cycle-dots" aria-hidden="true"></div>

      <!-- Color Palette -->
      <div class="shader-control">
        <label class="shader-control__label">Color Palette</label>
        <select class="shader-control__select" id="demo-preset">
          <optgroup label="Cosine">
            <option value="Rainbow">Rainbow</option>
            <option value="Cool Blue">Cool Blue</option>
            <option value="Neon Heat">Neon Heat</option>
            <option value="Golden">Golden</option>
            <option value="Retro">Retro</option>
          </optgroup>
          <optgroup label="4-Color">
            <option value="Neon">Neon</option>
            <option value="Sunset">Sunset</option>
            <option value="Aurora">Aurora</option>
            <option value="Dusk">Dusk</option>
            <option value="Retro 4C">Retro</option>
          </optgroup>
        </select>
      </div>

      <!-- Lines -->
      <div class="shader-control">
        <label class="shader-control__label">Lines</label>
        <div class="shader-control__range-wrap">
          <input type="range" class="shader-control__range" id="demo-line-count" min="5" max="60" step="1" value="20">
          <span class="shader-control__value" id="demo-line-count-display">20</span>
        </div>
      </div>

      <!-- Power -->
      <div class="shader-control">
        <label class="shader-control__label">Power</label>
        <div class="shader-control__range-wrap">
          <input type="range" class="shader-control__range" id="demo-power" min="0.5" max="6.0" step="0.1" value="2.5">
          <span class="shader-control__value" id="demo-power-display">2.5</span>
        </div>
      </div>

      <!-- Center Circle -->
      <div class="shader-control">
        <label class="shader-control__label">Center Circle</label>
        <div class="shader-control__range-wrap">
          <input type="range" class="shader-control__range" id="demo-center-circle" min="0.0" max="0.4" step="0.005" value="0.04">
          <span class="shader-control__value" id="demo-center-circle-display">0.04</span>
        </div>
      </div>

      <!-- Randomize -->
      <button type="button" class="shader-control__randomize-btn" id="demo-randomize">Randomize</button>

      <!-- All Settings (collapsible) -->
      <div class="shader-demo__all-settings">
        <button type="button" class="shader-demo__all-settings-toggle" id="demo-all-settings-toggle" aria-expanded="false">
          All Settings
          <span class="shader-demo__all-settings-chevron" aria-hidden="true">&#9660;</span>
        </button>
        <div class="shader-demo__all-settings-body" id="demo-all-settings-body" hidden>

          <p class="shader-demo__panel-label">Shape</p>

          <!-- Radius -->
          <div class="shader-control">
            <label class="shader-control__label">Radius</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-radius" min="0.05" max="0.5" step="0.01" value="0.31">
              <span class="shader-control__value" id="demo-radius-display">0.31</span>
            </div>
          </div>

          <!-- Width Top -->
          <div class="shader-control">
            <label class="shader-control__label">Width Top</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-width-top" min="0" max="1" step="0.01" value="0.05">
              <span class="shader-control__value" id="demo-width-top-display">0.05</span>
            </div>
          </div>

          <!-- Width Bottom -->
          <div class="shader-control">
            <label class="shader-control__label">Width Bottom</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-width-bot" min="0" max="1" step="0.01" value="0.75">
              <span class="shader-control__value" id="demo-width-bot-display">0.75</span>
            </div>
          </div>

          <p class="shader-demo__panel-label">Color Palette</p>

          <!-- Color Mode -->
          <div class="shader-control">
            <label class="shader-control__label">Color Mode</label>
            <div class="shader-control__with-help">
              <select class="shader-control__select" id="demo-color-mode">
                <option value="0">Cosine</option>
                <option value="1">4-Color</option>
              </select>
              <button type="button" class="shader-demo__help-btn" id="demo-cosine-help" aria-label="About cosine palette">?</button>
            </div>
          </div>

          <!-- Palette A -->
          <div class="shader-control" id="demo-palette-a-row">
            <label class="shader-control__label">Palette A</label>
            <input type="color" class="shader-control__color" id="demo-palette-a" value="#808080">
          </div>

          <!-- Palette B -->
          <div class="shader-control" id="demo-palette-b-row">
            <label class="shader-control__label">Palette B</label>
            <input type="color" class="shader-control__color" id="demo-palette-b" value="#808080">
          </div>

          <!-- Palette C -->
          <div class="shader-control" id="demo-palette-c-row">
            <label class="shader-control__label">Palette C</label>
            <input type="color" class="shader-control__color" id="demo-palette-c" value="#ffffff">
          </div>

          <!-- Palette D -->
          <div class="shader-control" id="demo-palette-d-row">
            <label class="shader-control__label">Palette D</label>
            <input type="color" class="shader-control__color" id="demo-palette-d" value="#0054ab">
          </div>

          <!-- Color 1 (Top) -->
          <div class="shader-control" id="demo-color0-row" style="display:none">
            <label class="shader-control__label">Color 1 (Top)</label>
            <input type="color" class="shader-control__color" id="demo-color0" value="#ff3366">
          </div>

          <!-- Color 2 -->
          <div class="shader-control" id="demo-color1-row" style="display:none">
            <label class="shader-control__label">Color 2</label>
            <input type="color" class="shader-control__color" id="demo-color1" value="#ffcc00">
          </div>

          <!-- Color 3 -->
          <div class="shader-control" id="demo-color2-row" style="display:none">
            <label class="shader-control__label">Color 3</label>
            <input type="color" class="shader-control__color" id="demo-color2" value="#00ccff">
          </div>

          <!-- Color 4 (Bot) -->
          <div class="shader-control" id="demo-color3-row" style="display:none">
            <label class="shader-control__label">Color 4 (Bot)</label>
            <input type="color" class="shader-control__color" id="demo-color3" value="#aa00ff">
          </div>

          <p class="shader-demo__panel-label">Triangle Mask</p>

          <!-- Triangle Enabled -->
          <div class="shader-control">
            <label class="shader-control__label">Enabled</label>
            <button type="button" class="shader-control__toggle is-on" id="demo-tri-enabled" data-on="1">On</button>
          </div>

          <!-- Triangle Rotation -->
          <div class="shader-control">
            <label class="shader-control__label">Rotation (°)</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-tri-rotation" min="0" max="360" step="1" value="0">
              <span class="shader-control__value" id="demo-tri-rotation-display">0</span>
            </div>
          </div>

          <!-- Triangle Size -->
          <div class="shader-control">
            <label class="shader-control__label">Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-tri-size" min="0.1" max="2.0" step="0.01" value="1.0">
              <span class="shader-control__value" id="demo-tri-size-display">1</span>
            </div>
          </div>

          <!-- Triangle Base Width -->
          <div class="shader-control">
            <label class="shader-control__label">Base Width (°)</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-tri-width" min="5" max="89" step="1" value="45">
              <span class="shader-control__value" id="demo-tri-width-display">45</span>
            </div>
          </div>

          <p class="shader-demo__panel-label">Center Circle</p>

          <!-- Center Circle Enabled -->
          <div class="shader-control">
            <label class="shader-control__label">Enabled</label>
            <button type="button" class="shader-control__toggle is-on" id="demo-center-circle-enabled" data-on="1">On</button>
          </div>

          <p class="shader-demo__panel-label">Text Overlay</p>

          <!-- Enable Text -->
          <div class="shader-control">
            <label class="shader-control__label">Enable Text</label>
            <button type="button" class="shader-control__toggle" id="demo-enable-text" data-on="0">Off</button>
          </div>

          <!-- Text -->
          <div class="shader-control">
            <label class="shader-control__label">Text</label>
            <input type="text" class="shader-control__text-input" id="demo-text" value="{{ 'now' | date: '%Y' }}" placeholder="Your text">
          </div>

          <!-- Font -->
          <div class="shader-control">
            <label class="shader-control__label">Font</label>
            <select class="shader-control__select" id="demo-text-font">
              <option value="Oswald">Oswald</option>
              <option value="Unbounded">Unbounded</option>
              <option value="Bricolage Grotesque">Bricolage Grotesque</option>
              <option value="DM Mono">DM Mono</option>
              <option value="Righteous">Righteous</option>
              <option value="Teko">Teko</option>
              <option value="Big Shoulders Display">Big Shoulders Display</option>
              <option value="Anton">Anton</option>
            </select>
          </div>

          <!-- Font Size -->
          <div class="shader-control">
            <label class="shader-control__label">Font Size</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-text-size" min="8" max="300" step="1" value="69">
              <span class="shader-control__value" id="demo-text-size-display">69</span>
            </div>
          </div>

          <!-- Text X -->
          <div class="shader-control">
            <label class="shader-control__label">Text X</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-text-x" min="0" max="1" step="0.01" value="0.5">
              <span class="shader-control__value" id="demo-text-x-display">0.5</span>
            </div>
          </div>

          <!-- Text Y -->
          <div class="shader-control">
            <label class="shader-control__label">Text Y</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-text-y" min="0" max="1" step="0.01" value="0.2">
              <span class="shader-control__value" id="demo-text-y-display">0.2</span>
            </div>
          </div>

          <!-- Custom Text Color -->
          <div class="shader-control">
            <label class="shader-control__label">Custom Color</label>
            <button type="button" class="shader-control__toggle" id="demo-use-text-color" data-on="0">Off</button>
          </div>

          <!-- Text Color -->
          <div class="shader-control" id="demo-text-color-row" style="display:none">
            <label class="shader-control__label">Text Color</label>
            <input type="color" class="shader-control__color" id="demo-text-color" value="#ffffff">
          </div>

          <!-- Outline -->
          <div class="shader-control">
            <label class="shader-control__label">Outline</label>
            <button type="button" class="shader-control__toggle" id="demo-outline-enabled" data-on="0">Off</button>
          </div>

          <!-- Outline Width -->
          <div class="shader-control" id="demo-outline-width-row" style="display:none">
            <label class="shader-control__label">Outline Width</label>
            <div class="shader-control__range-wrap">
              <input type="range" class="shader-control__range" id="demo-outline-width" min="1" max="60" step="1" value="8">
              <span class="shader-control__value" id="demo-outline-width-display">8</span>
            </div>
          </div>

          <!-- Outline Color -->
          <div class="shader-control" id="demo-outline-color-row" style="display:none">
            <label class="shader-control__label">Outline Color</label>
            <input type="color" class="shader-control__color" id="demo-outline-color" value="#000000">
          </div>

        </div>
      </div>

    </div>

  </div>

  <div class="shader-demo__footer container">
    <hr class="shader-demo__divider">
    <div class="shader-demo__cta-row">
      <button type="button" class="btn btn--primary" id="demo-preview-btn">
        Preview on Shirt
      </button>
      <a href="{{ section.settings.product_url }}" class="btn btn--outline">
        {{ section.settings.button_label | default: 'Buy Original' }}
      </a>
    </div>
    <p class="shader-demo__note">Full controls available on the product page</p>
  </div>
</section>

<!-- Cosine palette explainer modal -->
<div class="shader-demo__help-modal shader-demo__help-modal--hidden" id="demo-cosine-modal" role="dialog" aria-modal="true" aria-label="About cosine palette">
  <div class="shader-demo__help-modal__backdrop" id="demo-cosine-backdrop"></div>
  <div class="shader-demo__help-modal__box">
    <div class="shader-demo__help-modal__header">
      <span class="shader-demo__help-modal__title">Cosine Palette</span>
      <button class="shader-demo__help-modal__close" id="demo-cosine-close" aria-label="Close">&times;</button>
    </div>
    <div class="shader-demo__help-modal__body">
      <p class="shader-demo__help-modal__intro">A cosine palette generates smooth, cyclical color progressions by oscillating each RGB channel independently using a cosine wave.</p>
      <p class="shader-demo__help-modal__formula"><code>color = A + B &middot; cos(2&pi;(C &middot; t + D))</code></p>
      <dl class="shader-demo__help-modal__defs">
        <dt>A &mdash; Palette A</dt>
        <dd>Brightness offset. Sets the center point that colors oscillate around.</dd>
        <dt>B &mdash; Palette B</dt>
        <dd>Amplitude. Controls the range of color swing — higher means more vivid output.</dd>
        <dt>C &mdash; Palette C</dt>
        <dd>Frequency. How many times the palette cycles across the gradient.</dd>
        <dt>D &mdash; Palette D</dt>
        <dd>Phase. Shifts the starting hue of the cycle.</dd>
      </dl>
    </div>
  </div>
</div>

<!-- Mockup modal (reuses product page classes) -->
<div class="mockup-modal mockup-modal--hidden" id="demo-mockup-modal" role="dialog" aria-modal="true" aria-label="Shirt preview">
  <div class="mockup-modal__backdrop" id="demo-mockup-backdrop"></div>
  <div class="mockup-modal__box">
    <div class="mockup-modal__header">
      <span class="mockup-modal__title">Preview on Shirt</span>
      <button class="mockup-modal__close" id="demo-mockup-close" aria-label="Close preview">&times;</button>
    </div>
    <div class="mockup-modal__body">
      <p id="demo-mockup-loading" style="text-align:center;padding:2rem;color:var(--color-text-muted)">Generating preview…</p>
      <img class="mockup-modal__img" id="demo-mockup-img" src="" alt="Shirt mockup" style="display:none">
      <p id="demo-mockup-error" style="display:none;text-align:center;padding:2rem;color:var(--color-text-muted)">Preview failed. Please try again.</p>
    </div>
    <div class="mockup-modal__footer" id="demo-mockup-footer" style="display:none">
      <div class="mockup-modal__size" id="demo-mockup-size-wrap">
        <label class="mockup-modal__size-label" for="demo-mockup-size">Size</label>
        <select id="demo-mockup-size" class="mockup-modal__size-select">
          <option value="">Loading…</option>
        </select>
      </div>
      <div class="mockup-modal__footer-actions">
        <a id="demo-mockup-download" class="btn btn--outline btn--sm" download="my-design.jpg">Download</a>
        <button id="demo-mockup-order" class="btn btn--primary btn--sm">Order This Design</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  // ── Preset data ────────────────────────────────────────────────────────────
  // Each preset is self-contained: mode 0 = cosine (a/b/c/d), mode 1 = 4-stop (c0–c3).
  var PRESETS = {
    'Rainbow':   { mode: 0, a: [0.5,  0.5,  0.5 ], b: [0.5,  0.5,  0.5 ], c: [1.0, 1.0, 1.0 ], d: [0.0,  0.33, 0.67]  },
    'Cool Blue': { mode: 0, a: [0.5,  0.5,  0.5 ], b: [0.5,  0.5,  0.5 ], c: [1.0, 1.0, 1.0 ], d: [0.263,0.416,0.557] },
    'Neon Heat': { mode: 0, a: [0.5,  0.5,  0.5 ], b: [0.5,  0.5,  0.5 ], c: [1.0, 1.0, 1.0 ], d: [0.3,  0.2,  0.2  ] },
    'Golden':    { mode: 0, a: [0.5,  0.5,  0.5 ], b: [0.5,  0.5,  0.5 ], c: [1.0, 1.0, 0.5 ], d: [0.8,  0.9,  0.3  ] },
    'Retro':     { mode: 0, a: [0.6,  0.5,  0.3 ], b: [0.4,  0.4,  0.3 ], c: [1.0, 0.7, 0.5 ], d: [0.0,  0.2,  0.4  ] },
    'Neon':      { mode: 1, c0: [1.0,  0.2,  0.4  ], c1: [1.0,  0.8,  0.0  ], c2: [0.0,  0.8,  1.0  ], c3: [0.667,0.0,  1.0  ] },
    'Sunset':    { mode: 1, c0: [1.0,  0.318,0.184 ], c1: [0.867,0.141,0.463 ], c2: [0.541,0.169,0.886 ], c3: [0.098,0.098,0.439 ] },
    'Aurora':    { mode: 1, c0: [0.0,  1.0,  0.533 ], c1: [0.0,  0.898,1.0   ], c2: [0.486,0.302,1.0   ], c3: [0.878,0.251,0.984 ] },
    'Dusk':      { mode: 1, c0: [1.0,  0.6,  0.4   ], c1: [1.0,  0.369,0.384 ], c2: [0.8,  0.169,0.369 ], c3: [0.459,0.227,0.533 ] },
    'Retro 4C':  { mode: 1, c0: [0.91, 0.286,0.114 ], c1: [0.788,0.627,0.188 ], c2: [0.176,0.541,0.369 ], c3: [0.102,0.153,0.267 ] },
  };

  // Auto-cycle sequence — each step specifies preset + lineCount + power + centerCircle
  var CYCLE_STEPS = [
    { preset: 'Rainbow',  lineCount: 20, power: 2.5, centerCircle: 0.04  },
    { preset: 'Cool Blue',lineCount: 30, power: 1.5, centerCircle: 0.12  },
    { preset: 'Sunset',   lineCount: 15, power: 3.5, centerCircle: 0.08  },
    { preset: 'Neon Heat',lineCount: 25, power: 2.0, centerCircle: 0.18  },
    { preset: 'Aurora',   lineCount: 20, power: 4.0, centerCircle: 0.06  },
    { preset: 'Golden',   lineCount: 35, power: 2.0, centerCircle: 0.14  },
    { preset: 'Dusk',     lineCount: 12, power: 3.0, centerCircle: 0.0   },
    { preset: 'Retro',    lineCount: 18, power: 2.8, centerCircle: 0.10  },
  ];
  var CYCLE_INTERVAL_MS = 3000;

  // ── State ──────────────────────────────────────────────────────────────────
  window._demoState = {
    values: {
      u_line_count:  20,
      u_power:       2.5,
      u_radius:      0.31,
      u_width_top:   0.05,
      u_width_bot:   0.75,
      u_color_mode:             0,
      u_tri_enabled:            1,
      u_tri_rotation:           0,
      u_tri_size:               1.0,
      u_tri_width:              45,
      u_center_circle_enabled:  1,
      u_center_circle_radius:   0.04,
      u_palette_a: [0.5, 0.5, 0.5], u_palette_b: [0.5, 0.5, 0.5],
      u_palette_c: [1.0, 1.0, 1.0], u_palette_d: [0.0, 0.33, 0.67],
      u_color0: [1.0, 0.2, 0.4],   u_color1: [1.0, 0.8, 0.0],
      u_color2: [0.0, 0.8, 1.0],   u_color3: [0.667, 0.0, 1.0],
      text: '', textFont: 'Oswald', textFontSize: 69,
      textX: 0.5, textY: 0.2,
      u_use_text_color: 0, u_text_color: [1.0, 1.0, 1.0],
      outlineEnabled: false, outlineWidth: 8, u_outline_color: [0.0, 0.0, 0.0],
    },
    dirty: true,
  };

  // ── DOM refs ───────────────────────────────────────────────────────────────
  var presetSel      = document.getElementById('demo-preset');
  var lineCountInput = document.getElementById('demo-line-count');
  var lineCountDisp  = document.getElementById('demo-line-count-display');
  var powerInput          = document.getElementById('demo-power');
  var powerDisp           = document.getElementById('demo-power-display');
  var centerCircleInput   = document.getElementById('demo-center-circle');
  var centerCircleDisp    = document.getElementById('demo-center-circle-display');
  var randomizeBtn        = document.getElementById('demo-randomize');
  var dotsWrap            = document.getElementById('demo-cycle-dots');
  var allSettingsToggle   = document.getElementById('demo-all-settings-toggle');
  var allSettingsBody     = document.getElementById('demo-all-settings-body');
  var radiusInput         = document.getElementById('demo-radius');
  var radiusDisp          = document.getElementById('demo-radius-display');
  var widthTopInput       = document.getElementById('demo-width-top');
  var widthTopDisp        = document.getElementById('demo-width-top-display');
  var widthBotInput       = document.getElementById('demo-width-bot');
  var widthBotDisp        = document.getElementById('demo-width-bot-display');
  var triEnabledBtn       = document.getElementById('demo-tri-enabled');
  var triRotationInput    = document.getElementById('demo-tri-rotation');
  var triRotationDisp     = document.getElementById('demo-tri-rotation-display');
  var triSizeInput        = document.getElementById('demo-tri-size');
  var triSizeDisp         = document.getElementById('demo-tri-size-display');
  var triWidthInput       = document.getElementById('demo-tri-width');
  var triWidthDisp        = document.getElementById('demo-tri-width-display');
  var centerCircleEnabledBtn = document.getElementById('demo-center-circle-enabled');
  var colorModeSel        = document.getElementById('demo-color-mode');
  var cosineHelpBtn       = document.getElementById('demo-cosine-help');
  var cosineModal         = document.getElementById('demo-cosine-modal');
  var cosineBackdrop      = document.getElementById('demo-cosine-backdrop');
  var cosineClose         = document.getElementById('demo-cosine-close');
  var paletteAInput       = document.getElementById('demo-palette-a');
  var paletteBInput       = document.getElementById('demo-palette-b');
  var paletteCInput       = document.getElementById('demo-palette-c');
  var paletteDInput       = document.getElementById('demo-palette-d');
  var paletteRows         = ['demo-palette-a-row','demo-palette-b-row','demo-palette-c-row','demo-palette-d-row'].map(function(id){ return document.getElementById(id); });
