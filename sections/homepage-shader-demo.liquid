  // ── Preview on Shirt ───────────────────────────────────────────────────────
  var WORKER_BASE_URL    = 'https://brightfield-mockup-worker.eric-d-johnson.workers.dev';
  var PRODUCT_HANDLE     = {{ section.settings.product_handle | default: 'line-circle' | json }};
  var PRINT_AREA         = [0.30, 0.20, 0.40, 0.45];
  var currentDesignUrl   = null;
  var _lastMockupData    = null;
  var _pendingDesign     = null;
  var variantsLoaded     = false;

  // Preload shirt template so compositing is instant on click
  var shirtImg = new Image();
  shirtImg.crossOrigin = 'anonymous';
  shirtImg.src = {{ 'shirt-template.png' | asset_url | json }};

  function loadVariants() {
    if (variantsLoaded) return;
    variantsLoaded = true;
    fetch('/products/' + PRODUCT_HANDLE + '.js')
      .then(function (r) { return r.json(); })
      .then(function (product) {
        var sel = document.getElementById('demo-mockup-size');
        if (!sel) return;
        var sizeOrder = ['XS','S','M','L','XL','2XL','3XL','4XL','5XL'];
        var sorted = product.variants.slice().sort(function (a, b) {
          var ai = sizeOrder.indexOf(a.title); var bi = sizeOrder.indexOf(b.title);
          if (ai === -1) ai = 999; if (bi === -1) bi = 999;
          return ai - bi;
        });
        sel.innerHTML = '';
        sorted.forEach(function (v) {
          var opt       = document.createElement('option');
          opt.value     = v.id;
          opt.textContent = v.title;
          if (!v.available) opt.disabled = true;
          sel.appendChild(opt);
        });
        // Hide size row if only one variant
        var sizeWrap = document.getElementById('demo-mockup-size-wrap');
