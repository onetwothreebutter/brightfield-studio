    var n = parseFloat(this.value);
    window._demoState.values.u_width_top = n;
    widthTopDisp.textContent = n;
    window._demoState.dirty = true;
  });

  widthBotInput.addEventListener('input', function () {
    onUserInteract();
    var n = parseFloat(this.value);
    window._demoState.values.u_width_bot = n;
    widthBotDisp.textContent = n;
    window._demoState.dirty = true;
  });

  triEnabledBtn.addEventListener('click', function () {
    onUserInteract();
    var isOn = this.dataset.on === '1';
    var next = isOn ? 0 : 1;
    window._demoState.values.u_tri_enabled = next;
    this.dataset.on  = next ? '1' : '0';
    this.textContent = next ? 'On' : 'Off';
    this.classList.toggle('is-on', !!next);
    window._demoState.dirty = true;
  });

  triRotationInput.addEventListener('input', function () {
    onUserInteract();
