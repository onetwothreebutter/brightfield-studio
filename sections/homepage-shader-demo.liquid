  // ── Preview on Shirt ───────────────────────────────────────────────────────
  var MOCKUP_WORKER      = 'https://brightfield-mockup-worker.eric-d-johnson.workers.dev/generate-mockup';
  var MOCKUP_VARIANT_ID  = 4017;
  var PRODUCT_HANDLE     = {{ section.settings.product_handle | default: 'line-circle' | json }};
  var currentDesignUrl   = null;
  var variantsLoaded     = false;

  function loadVariants() {
    if (variantsLoaded) return;
    variantsLoaded = true;
    fetch('/products/' + PRODUCT_HANDLE + '.js')
      .then(function (r) { return r.json(); })
      .then(function (product) {
        var sel = document.getElementById('demo-mockup-size');
        if (!sel) return;
        sel.innerHTML = '';
        product.variants.forEach(function (v) {
          var opt       = document.createElement('option');
          opt.value     = v.id;
          opt.textContent = v.title;
          if (!v.available) opt.disabled = true;
          sel.appendChild(opt);
        });
        // Hide size row if only one variant
        var sizeWrap = document.getElementById('demo-mockup-size-wrap');
        if (sizeWrap && product.variants.length <= 1) sizeWrap.style.display = 'none';
      })
      .catch(function () {
        var sizeWrap = document.getElementById('demo-mockup-size-wrap');
        if (sizeWrap) sizeWrap.style.display = 'none';
      });
  }

  function openMockupModal() {
    mockupModal.classList.remove('mockup-modal--hidden');
    mockupLoading.style.display = '';
    mockupImg.style.display = 'none';
    mockupError.style.display = 'none';
    if (mockupFooter) mockupFooter.style.display = 'none';
    document.body.style.overflow = 'hidden';
  }

  function closeMockupModal() {
    mockupModal.classList.add('mockup-modal--hidden');
    document.body.style.overflow = '';
  }

  mockupClose.addEventListener('click', closeMockupModal);
  mockupBackdrop.addEventListener('click', closeMockupModal);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeMockupModal(); closeCosineModal(); }
  });

  previewBtn.addEventListener('click', function () {
    if (!window._demoExport) return;
    loadVariants();
    openMockupModal();
    window._demoExport(1800, 2400, function (base64png) {
      fetch(MOCKUP_WORKER, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image: base64png, variant_id: MOCKUP_VARIANT_ID }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.mockup_url) throw new Error('No mockup_url in response');
          currentDesignUrl = data.design_url || null;
          mockupLoading.style.display = 'none';
          mockupImg.src = data.mockup_url;
          mockupImg.style.display = '';
          if (mockupDownload) mockupDownload.href = data.mockup_url;
          if (mockupFooter) mockupFooter.style.display = '';
        })
        .catch(function () {
          mockupLoading.style.display = 'none';
          mockupError.style.display = '';
        });
    });
  });

  if (mockupOrder) {
    mockupOrder.addEventListener('click', function () {
      if (!currentDesignUrl) {
        alert('Design URL not available. Try generating a new preview.');
        return;
      }
      var variantId = mockupSizeEl ? mockupSizeEl.value : null;
      if (!variantId) {
        alert('Could not determine variant. Please select a size and try again.');
        return;
      }
      mockupOrder.disabled    = true;
      mockupOrder.textContent = 'Adding…';
      fetch('/cart/add.js', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id:       Number(variantId),
          quantity: 1,
          properties: {
            '_design_url':   currentDesignUrl,
            '_mockup_url':   mockupImg.src,
            'Customization': 'Custom Shader Design'
          }
        })
      })
      .then(function (r) {
        if (!r.ok) return r.text().then(function (t) {
          var msg = 'Cart error (' + r.status + ')';
          try { msg = JSON.parse(t).description || msg; } catch (e) {}
          throw new Error(msg);
        });
        window.location.href = '/cart';
      })
      .catch(function (err) {
        alert('Could not add to cart: ' + err.message);
        mockupOrder.disabled    = false;
        mockupOrder.textContent = 'Order This Design';
      });
    });
  }

  // ── Boot ───────────────────────────────────────────────────────────────────
  applyColorModeVisibility();
  startCycle();
}());

// ── Mobile: fade controls as they scroll past the canvas bottom ───────────────
(function () {
  if (window.innerWidth > 800) return;
  var canvasWrap    = document.querySelector('.shader-demo__canvas-wrap');
  var controlsEl    = document.querySelector('.shader-demo__controls');
  var allSettingsEl = document.querySelector('.shader-demo__all-settings');
  if (!canvasWrap || !controlsEl) return;

  var FADE_ZONE = 72; // px — rows fade over this distance approaching canvas bottom

  function fadeRow(el, canvasBottom) {
    if (el.style.display === 'none') return;
    var rect    = el.getBoundingClientRect();
    var rowMid  = (rect.top + rect.bottom) / 2;
    var dist    = rowMid - canvasBottom;
    var opacity = dist <= 0 ? 0 : dist < FADE_ZONE ? dist / FADE_ZONE : 1;
    el.style.opacity       = opacity;
    el.style.pointerEvents = opacity < 0.15 ? 'none' : '';
  }

  function updateFade() {
    var canvasBottom = canvasWrap.getBoundingClientRect().bottom;
    var children = controlsEl.children;
    for (var i = 0; i < children.length; i++) {
      var child = children[i];
      if (child === allSettingsEl) {
        // Fade the toggle button as its own row
        var toggle = child.querySelector('.shader-demo__all-settings-toggle');
        if (toggle) fadeRow(toggle, canvasBottom);
        // Fade each row in the body individually when expanded
        var body = child.querySelector('.shader-demo__all-settings-body');
        if (body && !body.hidden) {
          for (var j = 0; j < body.children.length; j++) {
            fadeRow(body.children[j], canvasBottom);
          }
        }
      } else {
        fadeRow(child, canvasBottom);
      }
    }
  }

  window.addEventListener('scroll', updateFade, { passive: true });
  updateFade();
}());
</script>

