<div class="not-found">
  <canvas class="not-found__canvas" id="shader-404-canvas"></canvas>
</div>

<script src="{{ 'shader-404.js' | asset_url }}" defer></script>

{% stylesheet %}
  .not-found {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow: hidden;
  }

  .not-found__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "presets": [
    { "name": "404" }
  ]
}
{% endschema %}
