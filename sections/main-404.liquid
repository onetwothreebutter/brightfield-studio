<div class="not-found section-padding">
  <div class="container">
    <div class="not-found__inner">
      <p class="not-found__code glitch" data-text="404">404</p>
      <h1 class="not-found__heading">Page not found.</h1>
      <p class="not-found__sub">This URL didn't compile.</p>
      <a href="/" class="btn btn--outline">Go Home</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    gap: 1.5rem;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    margin: 0;
  }

  .not-found__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .not-found__sub {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "presets": [
    { "name": "404" }
  ]
}
{% endschema %}
