<div class="not-found">
  <canvas class="not-found__canvas" id="shader-404-canvas"></canvas>
  <div class="not-found__overlay">
    <p class="not-found__code glitch" data-text="404">404</p>
    <h1 class="not-found__heading">Page not found.</h1>
    <p class="not-found__sub">Signal lost.</p>
    <a href="/" class="btn btn--outline">Go Home</a>
  </div>
</div>

<script src="{{ 'shader-404.js' | asset_url }}" defer></script>

{% stylesheet %}
  .not-found {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow: hidden;
  }

  .not-found__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .not-found__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    gap: 1.25rem;
    padding: 2rem;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    margin: 0;
  }

  .not-found__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .not-found__sub {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "presets": [
    { "name": "404" }
  ]
}
{% endschema %}
