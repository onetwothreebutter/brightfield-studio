<div class="cart-page section-padding">
  <div class="container">

    <h1 class="cart-page__title glitch" data-text="Your Cart">Your Cart</h1>

    {%- if cart.item_count == 0 -%}

      <div class="cart-empty">
        <p class="cart-empty__message">Your cart is empty.</p>
        <a href="/collections/in-house-designs" class="btn btn--primary btn--lg">Shop the Collection</a>
      </div>

    {%- else -%}

      <form action="/cart" method="post" class="cart-form">

        <div class="cart-items">
          {%- for item in cart.items -%}
            {%- comment -%}
              Items added before the worker served images itself have _mockup_url
              pointing at the rate-limited pub-*.r2.dev domain — rewrite those to
              the worker's /img/ route. ?w=320 serves a real thumbnail (2x the
              160px slot) instead of the 4–5 MB original.
            {%- endcomment -%}
            {%- assign mockup_url = item.properties['_mockup_url'] | replace: 'https://pub-6029e26e344643f388b32734c4c2f53e.r2.dev/', 'https://share.brightfield.studio/img/' -%}
            {%- if mockup_url contains 'share.brightfield.studio/img/' -%}
              {%- assign mockup_url = mockup_url | append: '?w=320' -%}
            {%- endif -%}
            {%- if item.properties['_design_url'] != blank and item.properties['_source'] != 'inhouse' -%}
              {%- assign is_custom = item.properties['_design_url'] -%}
            {%- elsif item.properties['Design Type'] == 'Community Design' -%}
              {%- assign is_custom = 'community' -%}
            {%- else -%}
              {%- assign is_custom = '' -%}
            {%- endif -%}
            {%- assign design_id = item.properties['_design_id'] -%}
            {%- if item.properties['Design Type'] == 'Community Design' and design_id != blank -%}
              {%- assign design_detail_url = '/pages/community-design?id=' | append: design_id -%}
            {%- else -%}
              {%- assign design_detail_url = '' -%}
            {%- endif -%}

            <div class="cart-item">

              <a href="{{ design_detail_url | default: item.url }}" class="cart-item__image-link">
                {%- if mockup_url != blank -%}
                  <img
                    src="{{ mockup_url }}"
                    alt="Custom design preview"
                    class="cart-item__image cart-item__image--mockup"
                    width="160"
                    height="160"
                    loading="lazy"
                  >
                {%- elsif item.image -%}
                  {{
                    item.image
                    | image_url: width: 160
                    | image_tag:
                      alt: item.image.alt,
                      class: 'cart-item__image',
                      width: 160,
                      height: 160,
                      loading: 'lazy'
                  }}
                {%- endif -%}
              </a>

              <div class="cart-item__details">
                <a href="{{ design_detail_url | default: item.url }}" class="cart-item__title">
                  {{ item.product.title }}
                  {%- if is_custom != blank -%}
                    {%- if item.properties['Design Type'] == 'Community Design' -%}
                      <span class="cart-item__custom-badge">Community Design</span>
                    {%- else -%}
                      <span class="cart-item__custom-badge">Custom Design</span>
                    {%- endif -%}
                  {%- endif -%}
                </a>
                {%- if item.properties['Size'] != blank -%}
                  <p class="cart-item__variant">{{ item.properties['Size'] }}</p>
                {%- elsif item.variant.title != 'Default Title' -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endif -%}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>

                <div class="cart-item__qty">
                  <label for="qty-{{ item.index }}" class="visually-hidden">Quantity</label>
                  <input
                    id="qty-{{ item.index }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="cart-item__qty-input"
                  >
                  <a
                    href="{{ item.url_to_remove }}"
                    class="cart-item__remove"
                    aria-label="Remove {{ item.product.title | escape }}"
                  >Remove</a>
                </div>
              </div>

            </div>
          {%- endfor -%}
        </div>

        <div class="cart-footer">
          <div class="cart-subtotal">
            <span class="cart-subtotal__label">Subtotal</span>
            <span class="cart-subtotal__price">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-subtotal__note">Shipping and taxes calculated at checkout.</p>
          <div class="cart-actions">
            <button type="submit" name="update" class="btn btn--outline">Update Cart</button>
            <button type="submit" name="checkout" class="btn btn--primary btn--lg">Checkout</button>
          </div>
        </div>

      </form>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
