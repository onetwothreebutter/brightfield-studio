{%- paginate collection.products by 12 -%}

<div class="collection-page section-padding">
  <div class="container">

    <div class="collection-header">
      <h1
        class="collection-title glitch"
        data-text="{{ collection.title | escape }}"
      >
        {{ collection.title | escape }}
      </h1>
      {%- if collection.description != blank -%}
        <div class="collection-description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="empty-state">No products in this collection yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {{ paginate | default_pagination }}
      </nav>
    {%- endif -%}

  </div>
</div>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
