<section class="community-designs-page section-padding">
  <div class="container">
    <p id="cd-redirecting">Loading design&hellip;</p>
  </div>
</section>

<script>
  (function () {
    var WORKER = 'https://brightfield-mockup-worker.eric-d-johnson.workers.dev';
    var id = new URLSearchParams(window.location.search).get('id');
    if (!id) {
      window.location.replace('/collections/community-designs');
      return;
    }
    fetch(WORKER + '/community/design/' + encodeURIComponent(id))
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (d && d.shopifyProductHandle) {
          window.location.replace('/products/' + encodeURIComponent(d.shopifyProductHandle));
        } else {
          window.location.replace('/collections/community-designs');
        }
      })
      .catch(function () { window.location.replace('/collections/community-designs'); });
  }());
</script>

{% schema %}
{
  "name": "Community Design",
  "settings": [],
  "presets": [{ "name": "Community Design" }]
}
{% endschema %}
