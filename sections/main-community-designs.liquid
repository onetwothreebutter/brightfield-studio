{%- assign community_col = collections['community-designs'] -%}
{%- paginate community_col.products by 24 -%}

{%- comment -%}
  Group slugs come from each product's own shader metafield rather than a
  hand-kept registry — a registry copy here silently dropped scribble-glyph
  and contour-pareidolia designs (saved to the collection but never
  rendered). Order is first appearance within the paginated collection.
{%- endcomment -%}
{%- assign shader_slugs_str = ',' -%}
{%- for product in community_col.products -%}
  {%- assign s = product.metafields.custom.shader -%}
  {%- if s != blank -%}
    {%- assign needle = s | prepend: ',' | append: ',' -%}
    {%- unless shader_slugs_str contains needle -%}
      {%- assign shader_slugs_str = shader_slugs_str | append: s | append: ',' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign shader_slugs = shader_slugs_str | remove_first: ',' | split: ',' -%}

<section class="community-designs-page section-padding">
  <div class="container">
    <h1 class="community-designs-page__heading">Community Designs</h1>
    <p class="community-designs-page__sub">Designs created and shared by the Brightfield community.</p>

    {%- if community_col.products.size == 0 -%}
      <p class="community-designs-page__empty">No designs yet &mdash; be the first to share one!</p>
    {%- else -%}
      <div id="community-page-container">
        {%- for shader_slug in shader_slugs -%}
          {%- assign words = shader_slug | split: '-' -%}
          {%- capture shader_label -%}{%- for word in words -%}{{ word | capitalize }}{%- unless forloop.last %} {% endunless -%}{%- endfor -%}{%- endcapture -%}
          <div class="community-card-group">
            <h3 class="community-card-group__heading">{{ shader_label }}</h3>
            <div class="product-grid">
              {%- for product in community_col.products -%}
                {%- if product.metafields.custom.shader == shader_slug -%}
                  {%- render 'community-card', product: product -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{%- endpaginate -%}

<script src="{{ 'community-designs.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.CommunityDesigns) {
      CommunityDesigns.hydrateInteractions();
    }
  });
</script>

{% schema %}
{
  "name": "Community Designs Page",
  "settings": [],
  "presets": [{ "name": "Community Designs Page" }]
}
{% endschema %}
