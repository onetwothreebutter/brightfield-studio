<div class="contact-page section-padding">
  <div class="container">
    <div class="contact-layout">

      <div class="contact-header">
        <p class="contact-eyebrow">Get in Touch</p>
        <h1 class="contact-title">{{ section.settings.heading }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="contact-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- form 'contact' -%}

        {%- if form.posted_successfully? -%}
          <p class="contact-success">Message sent — we'll get back to you soon.</p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="contact-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="contact-form">
          <div class="contact-field">
            <label class="contact-label" for="contact-name">Name</label>
            <input
              class="contact-input"
              type="text"
              id="contact-name"
              name="contact[name]"
              value="{{ form.name }}"
              autocomplete="name"
            >
          </div>

          <div class="contact-field">
            <label class="contact-label" for="contact-email">Email</label>
            <input
              class="contact-input"
              type="email"
              id="contact-email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              required
            >
          </div>

          <div class="contact-field">
            <label class="contact-label" for="contact-message">Message</label>
            <textarea
              class="contact-input contact-input--textarea"
              id="contact-message"
              name="contact[body]"
              rows="6"
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--lg">Send Message</button>
        </div>

      {%- endform -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Questions about an order, custom work, or just want to say hi?"
    }
  ],
  "presets": [
    { "name": "Contact" }
  ]
}
{% endschema %}
