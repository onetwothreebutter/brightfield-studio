{%- assign shader_file = nil -%}
{%- assign is_community_design = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_prefix = tag | slice: 0, 7 -%}
  {%- if tag_prefix == 'shader-' -%}
    {%- assign shader_file = tag | remove_first: 'shader-' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if product.tags contains 'community-design' -%}
  {%- assign is_community_design = true -%}
  {%- assign submission_id = product.metafields.custom.submission_id | default: '' -%}
{%- endif -%}

{%- if shader_file -%}
<style>
.anim-settings-toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(12px);
  background: #1a1a1a;
  color: #00ffff;
  border: 1px solid #00ffff;
  font-family: "IBM Plex Mono", monospace;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  padding: 0.4rem 1rem;
  border-radius: 4px;
  box-shadow: 0 0 12px rgba(0, 255, 255, 0.2);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 10002;
}
.anim-settings-toast--visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
</style>
{%- endif -%}

<div class="product-page section-padding">
  <div class="container">
    <div class="product-layout">

      <!-- Vendor + title duplicated for mobile — hidden on desktop -->
      <div class="product-title-mobile">
        {%- if product.vendor != blank -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}
        <h1
          class="product-title glitch"
          data-text="{{ product.title | escape }}"
        >
          {{ product.title | escape }}
        </h1>
        {%- assign creator_name = product.metafields.custom.creator_name -%}
        {%- if creator_name != blank -%}
          <p class="product-creator">Designed by {{ creator_name | escape }}</p>
        {%- endif -%}
      </div>

      {%- comment -%}
        submission_id is deliberately not passed: on main it was assigned
        further down the page than the canvas, so the canvas's community-design
        opacity:0 hold never rendered. Passing it would change that behaviour,
        which is out of scope for this refactor.
      {%- endcomment -%}
      {%- render 'product-media', product: product, shader_file: shader_file, is_community_design: is_community_design -%}

      {%- render 'product-info', product: product, shader_file: shader_file, is_community_design: is_community_design, submission_id: submission_id -%}

    </div>

    {%- if shader_file -%}
    {%- unless product.tags contains 'community-design' -%}
    <div class="product-recent-designs" id="product-recent-designs" style="display:none">
      <h3 class="product-recent-designs__heading">Your Recent Designs</h3>
      <div id="product-recent-designs-container"></div>
    </div>
    {%- endunless -%}
    <div class="product-community-designs" id="product-community-designs" style="display:none">
      <h3 class="product-recent-designs__heading">Community Designs</h3>
      <div id="product-community-designs-container"></div>
    </div>
    {%- endif -%}

    {%- render 'product-reviews', product: product -%}

  </div>
</div>

<script type="application/json" id="bf-product-config">
{
  "currency": {{ shop.currency | json }},
  "productTitle": {{ product.title | json }},
  "productHandle": {{ product.handle | json }},
  "variant": {
    "id": {{ product.selected_or_first_available_variant.id | json }},
    "title": {{ product.selected_or_first_available_variant.title | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }}
  },
  "shader": {{ shader_file | json }},
  "submissionId": {{ submission_id | default: '' | json }},
  "holdReveal": {% if is_community_design and submission_id != blank %}true{% else %}false{% endif %}
}
</script>

{%- if shader_file -%}
<script>
// The shader's control definition. Rendered inline because the snippets are
// Liquid; assets/product-shader-gui.js builds the panel from what this exposes.
window.BFShaderDef = (function () {
  var body = document.getElementById('shader-gui-body');
  if (!body) return null;

  {% render 'shader-controls-base' %}
  {% case shader_file %}
  {% when 'chladni' %}          {% render 'shader-controls-chladni' %}
  {% when 'circle-on-line' %}   {% render 'shader-controls-circle-on-line' %}
  {% when 'line-circle' %}      {% render 'shader-controls-line-circle' %}
  {% when 'three-square' %}     {% render 'shader-controls-three-square' %}
  {% when 'four-circles' %}     {% render 'shader-controls-four-circles' %}
  {% when 'scaling-letters' %} {% render 'shader-controls-scaling-letters' %}
  {% when 'stacked-gradient' %} {% render 'shader-controls-stacked-gradient' %}
  {% when 'echo-text' %}        {% render 'shader-controls-echo-text' %}
  {% when 'line-text' %}        {% render 'shader-controls-line-text' %}
  {% when 'outline-pulse' %}    {% render 'shader-controls-outline-pulse' %}
  {% when 'contour-pareidolia' %} {% render 'shader-controls-contour-pareidolia' %}
  {% when 'scribble-glyph' %}   {% render 'shader-controls-scribble-glyph' %}
  {% else %}                    {% render 'shader-controls-rise-shirt' %}
  {% endcase %}

  return {
    body: body,
    controls: controls,
    customAfterBuild: typeof customAfterBuild === 'function' ? customAfterBuild : null,
    lib: {
      COSINE_PRESETS: COSINE_PRESETS, FOUR_STOP_PRESETS: FOUR_STOP_PRESETS,
      vividHex: vividHex, cosinePresetGradient: cosinePresetGradient,
      fourStopPresetGradient: fourStopPresetGradient, applyColors: applyColors,
      toHex: toHex, hexToRgb: hexToRgb
    }
  };
}());
</script>
{%- endif -%}

<script src="{{ 'product-page.js' | asset_url }}" defer></script>
{%- if product.variants.size > 1 -%}
<script src="{{ 'product-variant-sync.js' | asset_url }}" defer></script>
{%- endif -%}
<script src="{{ 'product-design-assistant.js' | asset_url }}" defer></script>
{%- if shader_file -%}
<script src="{{ 'product-shader-gui.js' | asset_url }}" defer></script>
<script src="{{ 'product-preview-shirt.js' | asset_url }}" defer></script>

<script src="{{ 'shader-base.js' | asset_url }}" defer></script>
<script src="{{ shader_file | append: '.js' | asset_url }}" defer></script>
<script src="{{ 'recent-designs.js' | asset_url }}" defer></script>
<script src="{{ 'community-designs.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
