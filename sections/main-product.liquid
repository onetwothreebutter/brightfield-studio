{%- assign shader_file = nil -%}
{%- assign is_community_design = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_prefix = tag | slice: 0, 7 -%}
  {%- if tag_prefix == 'shader-' -%}
    {%- assign shader_file = tag | remove_first: 'shader-' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if product.tags contains 'community-design' -%}
  {%- assign is_community_design = true -%}
{%- endif -%}

{%- if shader_file -%}
<style>
.anim-settings-toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(12px);
  background: #1a1a1a;
  color: #00ffff;
  border: 1px solid #00ffff;
  font-family: "IBM Plex Mono", monospace;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  padding: 0.4rem 1rem;
  border-radius: 4px;
  box-shadow: 0 0 12px rgba(0, 255, 255, 0.2);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 10002;
}
.anim-settings-toast--visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
</style>
{%- endif -%}

<div class="product-page section-padding">
  <div class="container">
    <div class="product-layout">

      <!-- Vendor + title duplicated for mobile — hidden on desktop -->
      <div class="product-title-mobile">
        {%- if product.vendor != blank -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}
        <h1
          class="product-title glitch"
          data-text="{{ product.title | escape }}"
        >
          {{ product.title | escape }}
        </h1>
        {%- assign creator_name = product.metafields.custom.creator_name -%}
        {%- if creator_name != blank -%}
          <p class="product-creator">Designed by {{ creator_name | escape }}</p>
        {%- endif -%}
      </div>

      <!-- Media -->
      {%- assign mockup_url = product.metafields.custom.mockup_url | default: '' -%}
      <div class="product-media">

        <!-- Photo panel -->
        <div class="media-panel is-active" data-panel="photo">
          <div class="product-media__main">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="product-media__image"
                width="900"
                height="900"
              >
            {%- endif -%}
          </div>
          {%- if product.images.size > 1 or mockup_url != blank -%}
            <div class="product-media__thumbs">
              {%- for image in product.images -%}
                <img
                  src="{{ image | image_url: width: 150 }}"
                  alt="{{ image.alt | escape }}"
                  class="product-thumb{% if forloop.first %} is-active{% endif %}"
                  data-full="{{ image | image_url: width: 900 }}"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              {%- endfor -%}
              {%- if mockup_url != blank -%}
                <img
                  src="{{ mockup_url }}"
                  alt="Shirt preview"
                  class="product-thumb"
                  data-full="{{ mockup_url }}"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%}
          No size is preselected — the shopper must explicitly choose one
          (validated on submit below). With a no-returns policy, an
          accidental default-size order is a straight loss. An explicit
          ?variant= deep link (product.selected_variant) still wins, since
          that reflects an intentional choice rather than a default.
          default_variant is used only where a variant value is structurally
          required (price display, single-variant products) — never to mark
          a size as pre-checked.
        {%- endcomment -%}
        {%- assign default_variant = product.selected_or_first_available_variant -%}
        {%- assign preselected_variant = product.selected_variant -%}

        <!-- Shader panel — only shown when product has a shader-[file] tag -->
        {%- if shader_file -%}
        <div class="media-panel" data-panel="shader">
          <canvas id="shader-canvas" class="product-shader__canvas{% if shader_file == 'stacked-gradient' %} product-shader__canvas--square{% endif %}"{% if is_community_design and submission_id != blank %} style="opacity:0"{% endif %}></canvas>
          <!-- Mockup modal -->
          <div id="mockup-modal" class="mockup-modal mockup-modal--hidden">
            <div class="mockup-modal__backdrop"></div>
            <div class="mockup-modal__box">
              <div class="mockup-modal__header">
                <span class="mockup-modal__title">Shirt Preview</span>
                <button class="mockup-modal__close" id="mockup-modal-close" aria-label="Close">&times;</button>
              </div>
              <div class="mockup-modal__body">
                <img id="mockup-modal-img" class="mockup-modal__img" src="" alt="Shirt preview">
              </div>
              <div class="mockup-modal__footer">
                {%- if product.variants.size > 1 -%}
                  <div class="mockup-modal__size">
                    <label class="mockup-modal__size-label" for="mockup-size-select">Size</label>
                    <select id="mockup-size-select" class="mockup-modal__size-select">
                      <option value="" selected disabled>Select a size</option>
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          data-price="{{ variant.price | money | escape }}"
                          {% if preselected_variant and variant.id == preselected_variant.id %}selected{% endif %}
                          {% unless variant.available %}disabled{% endunless %}
                        >
                          {{ variant.title }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endif -%}
                <div class="mockup-modal__footer-actions">
                  <span class="mockup-modal__price" id="mockup-modal-price">{{ default_variant.price | money }}</span>
                  <button id="mockup-modal-order" class="btn btn--primary btn--sm btn--full">Add to Cart</button>
                </div>
                <p class="mockup-modal__order-status" id="mockup-order-status" role="status" aria-live="polite"></p>

                <!-- Shown only after a successful add-to-cart — gallery submission is
                     secondary to the sale, so it only appears once the purchase path
                     is already complete, never competing with Add to Cart. -->
                <div class="mockup-modal__success" id="mockup-modal-success" style="display:none">
                  <p class="mockup-modal__success-message">Added to your cart.</p>
                  <button class="btn btn--primary btn--sm btn--full" id="mockup-modal-continue">Continue to Cart</button>
                  <div class="mockup-modal__gallery-ask">
                    <button class="btn btn--ghost btn--sm btn--full" id="community-toggle">Submit this design to the gallery (optional)</button>
                    <div class="mockup-modal__community">
                      <div class="mockup-modal__community-form" id="community-form" style="display:none">
                        <p class="mockup-modal__community-note">Share this design to the community gallery so others can get inspired by it.</p>
                        <input type="text" id="community-name" class="mockup-modal__community-input" placeholder="Your name (displayed publicly)">
                        <input type="email" id="community-email" class="mockup-modal__community-input" placeholder="Email (kept private)">
                        <button class="btn btn--primary btn--sm" id="community-submit">Submit</button>
                        <p class="mockup-modal__community-error" id="community-error" style="display:none">Submission failed. Please try again.</p>
                        <p class="mockup-modal__community-note">Designs are reviewed before appearing publicly.</p>
                      </div>
                      <p class="mockup-modal__community-success" id="community-success" style="display:none">
                        Submitted! Your design will appear after review.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- In-house design assistant: built entirely by JS (see below) and only
               when ?new-inhouse-design is present, so the internal deploy workflow
               it describes never ships in the page's rendered HTML/DOM. -->
        </div>
        {%- endif -%}

      </div>

      <!-- Info -->
      <div class="product-info">
        {%- if product.vendor != blank -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1
          class="product-title glitch"
          data-text="{{ product.title | escape }}"
        >
          {{ product.title | escape }}
        </h1>

        {%- assign creator_name = product.metafields.custom.creator_name -%}
        {%- if creator_name != blank -%}
          <p class="product-creator">Designed by {{ creator_name | escape }}</p>
        {%- endif -%}

        <p class="product-price">
          {%- if product.compare_at_price > product.price -%}
            <s class="product-price__compare">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
          {{ product.price | money }}
        </p>

        <div id="product-order-form">
          {%- form 'product', product -%}

            {%- if product.variants.size > 1 -%}
              {%- for option in product.options_with_values -%}
                {%- assign opt_idx = option.position | minus: 1 -%}
                <fieldset class="variant-fieldset">
                  <legend class="variant-label">{{ option.name }}</legend>
                  <div class="variant-options">
                    {%- for value in option.values -%}
                      <label class="variant-option">
                        <input
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if preselected_variant and preselected_variant.options[opt_idx] == value %}checked{% endif %}
                        >
                        <span>{{ value | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}

              <p class="variant-error" id="variant-error" role="alert" tabindex="-1" style="display:none">Please select a size.</p>

              <select name="id" class="variant-select visually-hidden">
                <option value="" selected>Select a size</option>
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    data-variant-title="{{ variant.title | escape }}"
                    {% if preselected_variant and variant.id == preselected_variant.id %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }}
                  </option>
                {%- endfor -%}
              </select>

            {%- else -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {%- endif -%}

            <input type="hidden" name="quantity" value="1">
            {%- if shader_file -%}
            <input type="hidden" name="properties[_source]" value="inhouse">
            {%- endif -%}
            {%- if is_community_design -%}
            <input type="hidden" name="properties[Design Type]" value="Community Design">
            {%- assign submission_id = product.metafields.custom.submission_id | default: '' -%}
            {%- if submission_id != blank -%}
            <input type="hidden" name="properties[_design_id]" value="{{ submission_id | escape }}">
            {%- endif -%}
            {%- endif -%}

            <div class="product-actions">
              <button
                type="submit"
                class="btn btn--primary btn--lg btn--full"
                {% unless product.available %}disabled{% endunless %}
              >
                {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
              </button>
              {%- if shader_file -%}
              <button type="button" class="product-customize-btn btn btn--outline btn--lg" data-tab="shader">Design Yours</button>
              {%- endif -%}
            </div>

          {%- endform -%}
        </div>

        <div class="product-trust">
          <ul class="product-trust__list">
            <li>Unisex fit — true to size</li>
            <li><a href="/pages/faq#size-guide" id="size-guide-trigger" aria-haspopup="dialog">Size guide</a></li>
            <li>Printed to order in 2–5 business days</li>
            <li>Estimated arrival: 5–10 business days</li>
            <li>Free replacement for damage or print defects</li>
          </ul>
          <a class="product-trust__link" href="/pages/faq#shipping-returns">Shipping &amp; returns</a>
        </div>

        <dialog id="size-guide-modal" class="size-guide-modal" aria-labelledby="size-guide-modal-title">
          <div class="size-guide-modal__header">
            <h2 id="size-guide-modal-title" class="size-guide-modal__title">Size Guide</h2>
            <button type="button" class="size-guide-modal__close" id="size-guide-modal-close" aria-label="Close">&times;</button>
          </div>
          <div class="size-guide-modal__body">
            {%- render 'size-chart-table' -%}
          </div>
        </dialog>


        {%- if shader_file -%}
        <div class="shader-gui" id="shader-gui">
          <div class="shader-gui__mobile-bar">
            <button class="shader-gui__toggle" id="shader-gui-popout">Popout</button>
          </div>
          <p class="product-customize-hint">Adjust the controls to customize colors, patterns, and text — then use <em>Preview on Shirt</em> to see how it looks.</p>
          <div class="scroll-shadow scroll-shadow--top" aria-hidden="true"></div>
<div class="shader-gui__body" id="shader-gui-body"></div>
          <div class="scroll-shadow scroll-shadow--bottom" aria-hidden="true"></div>
        </div>
        <div class="shader-gui__preview">
          <button
            id="shader-preview-btn"
            class="btn btn--primary btn--lg btn--full"
            data-worker-url="https://brightfield-mockup-worker.eric-d-johnson.workers.dev"
            data-shirt-template="{{ 'shirt-template.png' | asset_url }}"
            data-print-area="0.30,0.165,0.40,0.45"
          >Preview on Shirt</button>
          <div class="shader-secondary-actions">
            <button class="shader-back-btn" data-tab="photo">← Back</button>
          </div>
          <p class="product-customize-actions__note">You'll select your size when you order.</p>
        </div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="product-description rte">
            {{ product.description }}
          </div>
        {%- endif -%}
      </div>

    </div>

    {%- if shader_file -%}
    {%- unless product.tags contains 'community-design' -%}
    <div class="product-recent-designs" id="product-recent-designs" style="display:none">
      <h3 class="product-recent-designs__heading">Your Recent Designs</h3>
      <div id="product-recent-designs-container"></div>
    </div>
    {%- endunless -%}
    <div class="product-community-designs" id="product-community-designs" style="display:none">
      <h3 class="product-recent-designs__heading">Community Designs</h3>
      <div id="product-community-designs-container"></div>
    </div>
    {%- endif -%}

    {%- comment -%}
      ── Reviews (issue #548, metafield-based) ──────────────────────────────
      No review app is installed (see PR description for the Judge.me-vs-
      metafield tradeoff), so reviews live entirely on product metafields:
        custom.review_average — number_decimal, e.g. "4.3"
        custom.review_count   — number_integer
        custom.review_entries — json array of { rating, author, body, created_at }
      These are written by the worker (worker/src/index.js, syncReviewMetafields)
      each time an admin approves/rejects a pending submission — never written
      from Liquid/the storefront directly.

      review_average/review_count below are also exactly what issue #541's
      Product JSON-LD (structured-data.liquid, not created yet) will want for
      `aggregateRating.ratingValue` / `.reviewCount` — a follow-up patch there
      can read the same two metafields straight off `product`.
    {%- endcomment -%}
    {%- assign review_count = product.metafields.custom.review_count.value | default: 0 -%}
    {%- assign review_average = product.metafields.custom.review_average.value | default: 0 -%}
    {%- comment -%}
      Metafields of type `json` are auto-parsed by Liquid — `.value` is
      already an array/hash here, not a JSON string. Piping it through
      `parse_json` works today only because the metafield doesn't exist yet
      (nil -> default '[]' string -> parse_json), but breaks with a Liquid
      render error the moment the worker writes real entries.
      https://shopify.dev/docs/api/liquid/objects/metafield
    {%- endcomment -%}
    {%- assign review_entries = product.metafields.custom.review_entries.value -%}

    <div class="product-reviews" id="product-reviews">
      <h2 class="product-reviews__heading">Reviews</h2>

      <div class="product-reviews__summary">
        {%- if review_count > 0 -%}
          {%- render 'star-rating', average: review_average, count: review_count, size: 'lg' -%}
          <p class="product-reviews__summary-text">
            {{ review_average }} out of 5 based on {{ review_count }} review{% if review_count != 1 %}s{% endif %}
          </p>
        {%- else -%}
          <p class="product-reviews__summary-text">No reviews yet — be the first to share your experience.</p>
        {%- endif -%}
      </div>

      {%- if review_entries.size > 0 -%}
        <ul class="product-reviews__list" role="list">
          {%- for entry in review_entries -%}
            <li class="product-review">
              <div class="product-review__header">
                {%- render 'star-rating', average: entry.rating, count: 1, hide_count: true -%}
                <span class="product-review__author">{{ entry.author | escape }}</span>
                {%- if entry.created_at -%}
                  <span class="product-review__date">{{ entry.created_at | date: '%B %d, %Y' }}</span>
                {%- endif -%}
              </div>
              <p class="product-review__body">{{ entry.body | escape }}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="product-reviews__form-wrap">
        <button type="button" class="btn btn--outline btn--sm" id="review-form-toggle" aria-expanded="false" aria-controls="review-form">
          Write a Review
        </button>

        <form class="product-reviews__form" id="review-form" style="display:none">
          <div class="product-reviews__form-field">
            <span id="review-rating-label">Rating</span>
            <div
              class="product-reviews__rating-input"
              id="review-rating-input"
              role="radiogroup"
              aria-labelledby="review-rating-label"
            >
              {%- for i in (1..5) reversed -%}
                <label class="product-reviews__star-label">
                  <input type="radio" name="rating" value="{{ i }}" required>
                  <span aria-hidden="true">★</span>
                  <span class="visually-hidden">{{ i }} star{% if i != 1 %}s{% endif %}</span>
                </label>
              {%- endfor -%}
            </div>
          </div>

          <div class="product-reviews__form-field">
            <label for="review-name">Your name</label>
            <input type="text" id="review-name" name="authorName" maxlength="80" autocomplete="name" required>
          </div>

          <div class="product-reviews__form-field">
            <label for="review-body">Your review</label>
            <textarea id="review-body" name="body" maxlength="2000" rows="4" required></textarea>
          </div>

          <!-- Honeypot: hidden from every user (see .product-reviews__honeypot in
               theme.css). Real customers never see or fill this; a bot that fills
               every field in the form does, and the worker silently no-ops on it. -->
          <div class="product-reviews__honeypot" aria-hidden="true">
            <label for="review-company">Company</label>
            <input type="text" id="review-company" name="company" tabindex="-1" autocomplete="off">
          </div>

          <button type="submit" class="btn btn--primary btn--sm" id="review-submit" data-worker-url="https://brightfield-mockup-worker.eric-d-johnson.workers.dev">
            Submit Review
          </button>
          <p class="product-reviews__form-error" id="review-error" role="alert" style="display:none">
            Something went wrong submitting your review. Please try again.
          </p>
          <p class="product-reviews__form-note">Reviews are moderated before appearing publicly.</p>
        </form>

        <p class="product-reviews__form-success" id="review-success" style="display:none">
          Thanks! Your review will appear after it's approved.
        </p>
      </div>
    </div>

  </div>
</div>

<script type="application/json" id="bf-product-config">
{
  "currency": {{ shop.currency | json }},
  "productTitle": {{ product.title | json }},
  "productHandle": {{ product.handle | json }},
  "variant": {
    "id": {{ product.selected_or_first_available_variant.id | json }},
    "title": {{ product.selected_or_first_available_variant.title | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }}
  },
  "shader": {{ shader_file | json }},
  "submissionId": {{ submission_id | default: '' | json }},
  "holdReveal": {% if is_community_design and submission_id != blank %}true{% else %}false{% endif %}
}
</script>

{%- if shader_file -%}
<script>
// The shader's control definition. Rendered inline because the snippets are
// Liquid; assets/product-shader-gui.js builds the panel from what this exposes.
window.BFShaderDef = (function () {
  var body = document.getElementById('shader-gui-body');
  if (!body) return null;

  {% render 'shader-controls-base' %}
  {% case shader_file %}
  {% when 'chladni' %}          {% render 'shader-controls-chladni' %}
  {% when 'circle-on-line' %}   {% render 'shader-controls-circle-on-line' %}
  {% when 'line-circle' %}      {% render 'shader-controls-line-circle' %}
  {% when 'three-square' %}     {% render 'shader-controls-three-square' %}
  {% when 'four-circles' %}     {% render 'shader-controls-four-circles' %}
  {% when 'scaling-letters' %} {% render 'shader-controls-scaling-letters' %}
  {% when 'stacked-gradient' %} {% render 'shader-controls-stacked-gradient' %}
  {% when 'echo-text' %}        {% render 'shader-controls-echo-text' %}
  {% when 'line-text' %}        {% render 'shader-controls-line-text' %}
  {% when 'outline-pulse' %}    {% render 'shader-controls-outline-pulse' %}
  {% when 'contour-pareidolia' %} {% render 'shader-controls-contour-pareidolia' %}
  {% when 'scribble-glyph' %}   {% render 'shader-controls-scribble-glyph' %}
  {% else %}                    {% render 'shader-controls-rise-shirt' %}
  {% endcase %}

  return {
    body: body,
    controls: controls,
    customAfterBuild: typeof customAfterBuild === 'function' ? customAfterBuild : null,
    lib: {
      COSINE_PRESETS: COSINE_PRESETS, FOUR_STOP_PRESETS: FOUR_STOP_PRESETS,
      vividHex: vividHex, cosinePresetGradient: cosinePresetGradient,
      fourStopPresetGradient: fourStopPresetGradient, applyColors: applyColors,
      toHex: toHex, hexToRgb: hexToRgb
    }
  };
}());
</script>
{%- endif -%}

<script src="{{ 'product-page.js' | asset_url }}" defer></script>
{%- if product.variants.size > 1 -%}
<script src="{{ 'product-variant-sync.js' | asset_url }}" defer></script>
{%- endif -%}
<script src="{{ 'product-design-assistant.js' | asset_url }}" defer></script>
{%- if shader_file -%}
<script src="{{ 'product-shader-gui.js' | asset_url }}" defer></script>
<script src="{{ 'product-preview-shirt.js' | asset_url }}" defer></script>

<script src="{{ 'shader-base.js' | asset_url }}" defer></script>
<script src="{{ shader_file | append: '.js' | asset_url }}" defer></script>
<script src="{{ 'recent-designs.js' | asset_url }}" defer></script>
<script src="{{ 'community-designs.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
