<div class="product-page section-padding">
  <div class="container">
    <div class="product-layout">

      <!-- Media -->
      {%- assign shader_src = product.metafields.shader.fragment_glsl.value -%}
      <div class="product-media">

        <div class="media-tabs">
          <button class="media-tab is-active" data-tab="photo">Photo</button>
          <button class="media-tab" data-tab="shader">Shader</button>
        </div>

        <!-- Photo panel -->
        <div class="media-panel is-active" data-panel="photo">
          <div class="product-media__main">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="product-media__image"
                width="900"
                height="900"
              >
            {%- endif -%}
          </div>
          {%- if product.images.size > 1 -%}
            <div class="product-media__thumbs">
              {%- for image in product.images -%}
                <img
                  src="{{ image | image_url: width: 150 }}"
                  alt="{{ image.alt | escape }}"
                  class="product-thumb{% if forloop.first %} is-active{% endif %}"
                  data-full="{{ image | image_url: width: 900 }}"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Shader panel — always shown; metafield overrides default GLSL if present -->
        <div class="media-panel" data-panel="shader">
          <canvas id="shader-canvas" class="product-shader__canvas"></canvas>
          {%- if shader_src != blank -%}
            <script id="shader-frag-src" type="application/json">{{ shader_src | json }}</script>
          {%- endif -%}
          <div class="shader-gui">
            <div class="shader-gui__header">
              <span class="shader-gui__title">Customize</span>
              <div class="shader-gui__header-actions">
                <button class="shader-gui__toggle" id="shader-gui-popout">Popout</button>
                <button class="shader-gui__toggle" id="shader-gui-toggle">Hide</button>
              </div>
            </div>
            <div class="shader-gui__preview">
              <button
                id="shader-preview-btn"
                class="shader-gui__toggle"
                data-variant-id="4017"
                data-worker-url="https://brightfield-mockup-worker.eric-d-johnson.workers.dev"
              >Preview on Shirt</button>
            </div>
            <div class="shader-gui__body" id="shader-gui-body"></div>
          </div>

          <!-- Mockup modal -->
          <div id="mockup-modal" class="mockup-modal mockup-modal--hidden">
            <div class="mockup-modal__backdrop"></div>
            <div class="mockup-modal__box">
              <div class="mockup-modal__header">
                <span class="mockup-modal__title">Shirt Preview</span>
                <button class="mockup-modal__close" id="mockup-modal-close" aria-label="Close">&times;</button>
              </div>
              <div class="mockup-modal__body">
                <img id="mockup-modal-img" class="mockup-modal__img" src="" alt="Shirt mockup">
              </div>
              <div class="mockup-modal__footer">
                <a id="mockup-modal-download" class="btn btn--outline btn--sm" download="mockup.jpg">Download</a>
                <button id="mockup-modal-order" class="btn btn--primary btn--sm">Order This Design</button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Info -->
      <div class="product-info">
        {%- if product.vendor != blank -%}
          <p class="product-vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1
          class="product-title glitch"
          data-text="{{ product.title | escape }}"
        >
          {{ product.title | escape }}
        </h1>

        <p class="product-price">
          {%- if product.compare_at_price > product.price -%}
            <s class="product-price__compare">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
          {{ product.price | money }}
        </p>

        {%- form 'product', product -%}

          {%- if product.variants.size > 1 -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="variant-fieldset">
                <legend class="variant-label">{{ option.name }}</legend>
                <div class="variant-options">
                  {%- for value in option.values -%}
                    <label class="variant-option">
                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}

            <select name="id" class="variant-select visually-hidden">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}
                </option>
              {%- endfor -%}
            </select>

          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- endif -%}

          <input type="hidden" name="quantity" value="1">

          <div class="product-actions">
            <button
              type="submit"
              class="btn btn--primary btn--lg btn--full"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
            </button>
          </div>

        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product-description rte">
            {{ product.description }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<script>
// ── Tab switcher ─────────────────────────────────────────────────────────────
(function () {
  var tabs   = document.querySelectorAll('.media-tab');
  var panels = document.querySelectorAll('.media-panel');
  if (!tabs.length) return;

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var target = this.dataset.tab;

      tabs.forEach(function (t) { t.classList.remove('is-active'); });
      panels.forEach(function (p) { p.classList.remove('is-active'); });

      this.classList.add('is-active');
      document.querySelector('[data-panel="' + target + '"]').classList.add('is-active');

      // Let rise-shirt.js resize now that the canvas is visible
      if (target === 'shader') {
        window.dispatchEvent(new Event('resize'));
      }
    });
  });
}());

// ── Thumbnail switcher ────────────────────────────────────────────────────────
(function () {
  var mainImg = document.querySelector('.product-media__image');
  var thumbs  = document.querySelectorAll('.product-thumb');
  if (!mainImg || !thumbs.length) return;

  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      mainImg.src = this.dataset.full;
      mainImg.alt = this.alt;
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      this.classList.add('is-active');
    });
  });
}());

// ── Shader GUI ────────────────────────────────────────────────────────────────
(function () {
  var body = document.getElementById('shader-gui-body');
  if (!body) return;

  var controls = [
    // ── Dots ──────────────────────────────────────────────────────────────
    { type: 'header', label: 'Dots' },
    { key: 'u_rows',           label: 'Rows',          type: 'range',  min: 10,   max: 200,  step: 1,    value: 23   },
    { key: 'u_cols',           label: 'Cols',          type: 'range',  min: 1,    max: 50,   step: 1,    value: 27   },
    { key: 'u_min_radius',     label: 'Min Radius',    type: 'range',  min: 0,    max: 0.5,  step: 0.01, value: 0.02 },
    { key: 'u_max_radius',     label: 'Max Radius',    type: 'range',  min: 0.1,  max: 1.5,  step: 0.01, value: 0.55 },
    { key: 'u_invert',         label: 'Invert',        type: 'toggle',                                   value: 1    },
    { key: 'u_dot_color',      label: 'Dot Color',     type: 'color',                                    value: '#ffffff' },
    { key: 'u_bg_color',       label: 'BG Color',      type: 'color',                                    value: '#000000' },
    { key: 'u_top_margin',     label: 'Top Margin',    type: 'range',  min: 0,    max: 1.0,  step: 0.01, value: 0.31 },
    // ── Text overlay ──────────────────────────────────────────────────────
    { type: 'header', label: 'Text Overlay' },
    { key: 'text',             label: 'Text',          type: 'text',                                     value: 'RISE', textDirty: true },
    { key: 'textX',            label: 'Text X',        type: 'range',  min: 0,    max: 1.0,  step: 0.01, value: 0.5,  textDirty: true },
    { key: 'textY',            label: 'Text Y',        type: 'range',  min: 0,    max: 1.0,  step: 0.01, value: 0.79, textDirty: true },
    { key: 'textFontSize',     label: 'Font Size',     type: 'range',  min: 50,   max: 800,  step: 10,   value: 320,  textDirty: true },
    { key: 'textFont',         label: 'Font',          type: 'select', textDirty: true, value: 'IBM Plex Mono',
      options: [
        { label: 'IBM Plex Mono', value: 'IBM Plex Mono' },
        { label: 'Space Grotesk', value: 'Space Grotesk' },
        { label: 'Anton',         value: 'Anton' },
        { label: 'Bebas Neue',    value: 'Bebas Neue' },
        { label: 'Playfair Display', value: 'Playfair Display' },
      ]
    },
    { key: 'u_text_grid_cols', label: 'Text Cols',     type: 'range',  min: 1,    max: 50,   step: 1,    value: 28   },
    { key: 'u_text_grid_rows', label: 'Text Rows',     type: 'range',  min: 1,    max: 100,  step: 1,    value: 39   },
    { key: 'u_text_radius',    label: 'Text Dot Size', type: 'range',  min: 0.01, max: 1.5,  step: 0.01, value: 0.33 },
    { key: 'u_text_blend',     label: 'Text Blend',    type: 'range',  min: 0,    max: 1.0,  step: 0.01, value: 1.0  },
    { key: 'u_text_color',     label: 'Text Color',    type: 'color',                                    value: '#ffffff' },
    { key: 'u_text_bg_color',  label: 'Text BG',       type: 'color',                                    value: '#000000' },
    // ── Palette ───────────────────────────────────────────────────────────
    { type: 'header', label: 'Palette' },
    { key: 'u_color_mode',  label: 'Use Palette',   type: 'toggle',                                   value: 1        },
    { key: 'u_palette_a',   label: 'Palette A',     type: 'color',                                    value: '#808080' },
    { key: 'u_palette_b',   label: 'Palette B',     type: 'color',                                    value: '#808080' },
    { key: 'u_palette_c',   label: 'Palette C',     type: 'color',                                    value: '#ffffff' },
    { key: 'u_palette_d',   label: 'Palette D',     type: 'color',                                    value: '#436a8e' }
  ];

  // Preload all shader fonts so canvas 2D context can use them immediately
  ['IBM Plex Mono', 'Space Grotesk', 'Anton', 'Bebas Neue', 'Playfair Display'].forEach(function (f) {
    document.fonts.load('bold 48px "' + f + '"');
  });

  // Initialise shared state — shader.js reads this each frame
  var values = {};
  controls.forEach(function (c) {
    if (!c.key) return;
    values[c.key] = c.type === 'color' ? hexToRgb(c.value) : c.value;
  });
  window._shaderState = { values: values, textDirty: true };

  // Build controls
  controls.forEach(function (ctrl) {
    if (ctrl.type === 'header') {
      var h = document.createElement('div');
      h.className   = 'shader-control__section-header';
      h.textContent = ctrl.label;
      body.appendChild(h);
      return;
    }

    var row = document.createElement('div');
    row.className = 'shader-control';

    var label = document.createElement('label');
    label.className   = 'shader-control__label';
    label.textContent = ctrl.label;
    row.appendChild(label);

    if (ctrl.type === 'range') {
      var wrap = document.createElement('div');
      wrap.className = 'shader-control__range-wrap';

      var input = document.createElement('input');
      input.type      = 'range';
      input.className = 'shader-control__range';
      input.min   = ctrl.min;
      input.max   = ctrl.max;
      input.step  = ctrl.step;
      input.value = ctrl.value;

      var display = document.createElement('span');
      display.className   = 'shader-control__value';
      display.textContent = ctrl.value;

      input.addEventListener('input', function () {
        var v = parseFloat(this.value);
        display.textContent = v;
        window._shaderState.values[ctrl.key] = v;
        if (ctrl.textDirty) window._shaderState.textDirty = true;
      });

      wrap.appendChild(input);
      wrap.appendChild(display);
      row.appendChild(wrap);

    } else if (ctrl.type === 'toggle') {
      var isOn = ctrl.value === 1;
      var btn  = document.createElement('button');
      btn.className   = 'shader-control__toggle' + (isOn ? ' is-on' : '');
      btn.textContent = isOn ? 'On' : 'Off';
      btn.dataset.on  = isOn ? '1' : '0';

      btn.addEventListener('click', function () {
        var wasOn = this.dataset.on === '1';
        this.dataset.on  = wasOn ? '0' : '1';
        this.textContent = wasOn ? 'Off' : 'On';
        this.classList.toggle('is-on', !wasOn);
        window._shaderState.values[ctrl.key] = wasOn ? 0 : 1;
      });

      row.appendChild(btn);

    } else if (ctrl.type === 'color') {
      var picker = document.createElement('input');
      picker.type      = 'color';
      picker.className = 'shader-control__color';
      picker.value     = ctrl.value;

      picker.addEventListener('input', function () {
        window._shaderState.values[ctrl.key] = hexToRgb(this.value);
        if (ctrl.textDirty) window._shaderState.textDirty = true;
      });

      row.appendChild(picker);

    } else if (ctrl.type === 'text') {
      var textInput       = document.createElement('input');
      textInput.type      = 'text';
      textInput.className = 'shader-control__text-input';
      textInput.value     = ctrl.value;
      textInput.placeholder = 'e.g. RISE';

      textInput.addEventListener('input', function () {
        window._shaderState.values[ctrl.key] = this.value;
        window._shaderState.textDirty = true;
      });

      row.appendChild(textInput);

    } else if (ctrl.type === 'select') {
      var sel = document.createElement('select');
      sel.className = 'shader-control__select';

      ctrl.options.forEach(function (opt) {
        var option = document.createElement('option');
        option.value       = opt.value;
        option.textContent = opt.label;
        if (opt.value === ctrl.value) option.selected = true;
        sel.appendChild(option);
      });

      sel.addEventListener('change', function () {
        window._shaderState.values[ctrl.key] = this.value;
        if (ctrl.textDirty) window._shaderState.textDirty = true;
      });

      row.appendChild(sel);
    }

    body.appendChild(row);
  });

  // Toggle panel visibility
  var toggle = document.getElementById('shader-gui-toggle');
  toggle.addEventListener('click', function () {
    var hidden = body.classList.toggle('is-hidden');
    this.textContent = hidden ? 'Show' : 'Hide';
  });

  // Popout / dock + drag
  var gui       = document.querySelector('.shader-gui');
  var guiHeader = document.querySelector('.shader-gui__header');
  var popoutBtn = document.getElementById('shader-gui-popout');
  var dragging  = false;
  var dragOX    = 0;
  var dragOY    = 0;

  popoutBtn.addEventListener('click', function () {
    if (gui.classList.contains('shader-gui--floating')) {
      gui.classList.remove('shader-gui--floating');
      gui.style.cssText = '';
      this.textContent  = 'Popout';
    } else {
      var rect        = gui.getBoundingClientRect();
      gui.style.left  = (rect.left + 16) + 'px';
      gui.style.top   = (rect.top  - 16) + 'px';
      gui.style.width = rect.width + 'px';
      gui.classList.add('shader-gui--floating');
      this.textContent = 'Dock';
    }
  });

  guiHeader.addEventListener('mousedown', function (e) {
    if (!gui.classList.contains('shader-gui--floating')) return;
    if (e.target.tagName === 'BUTTON') return;
    dragging = true;
    dragOX   = e.clientX - parseFloat(gui.style.left);
    dragOY   = e.clientY - parseFloat(gui.style.top);
    e.preventDefault();
  });

  document.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    gui.style.left = (e.clientX - dragOX) + 'px';
    gui.style.top  = (e.clientY - dragOY) + 'px';
  });

  document.addEventListener('mouseup', function () { dragging = false; });

  function hexToRgb(hex) {
    return [
      parseInt(hex.slice(1, 3), 16) / 255,
      parseInt(hex.slice(3, 5), 16) / 255,
      parseInt(hex.slice(5, 7), 16) / 255
    ];
  }
}());

// ── Preview on Shirt ──────────────────────────────────────────────────────────
(function () {
  var btn        = document.getElementById('shader-preview-btn');
  var modal      = document.getElementById('mockup-modal');
  var modalImg   = document.getElementById('mockup-modal-img');
  var modalDl    = document.getElementById('mockup-modal-download');
  var modalOrder = document.getElementById('mockup-modal-order');
  var closeBtn   = document.getElementById('mockup-modal-close');
  var backdrop   = modal.querySelector('.mockup-modal__backdrop');

  if (!btn) return;

  var currentDesignUrl = null;

  btn.addEventListener('click', function () {
    if (!window._shaderExport) {
      alert('Switch to the Shader tab first.');
      return;
    }

    var variantId = btn.dataset.variantId;
    var workerUrl = btn.dataset.workerUrl;

    btn.disabled    = true;
    btn.textContent = 'Generating…';

    window._shaderExport(1800, 2400, function (base64png) {
      fetch(workerUrl + '/generate-mockup', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ image: base64png, variant_id: variantId })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.mockup_url) throw new Error(data.error || 'No mockup URL returned');
        currentDesignUrl    = data.design_url || null;
        modalImg.src        = data.mockup_url;
        modalDl.href        = data.mockup_url;
        modal.classList.remove('mockup-modal--hidden');
        document.body.style.overflow = 'hidden';
      })
      .catch(function (err) {
        alert('Mockup failed: ' + err.message);
      })
      .finally(function () {
        btn.disabled    = false;
        btn.textContent = 'Preview on Shirt';
      });
    });
  });

  modalOrder.addEventListener('click', function () {
    if (!currentDesignUrl) {
      alert('Design URL not available. Try generating a new preview.');
      return;
    }

    // Read the currently selected Shopify variant ID from the product form
    var shopifyVariantId = (document.querySelector('input[name="id"]') || {}).value;
    if (!shopifyVariantId) {
      alert('Could not determine variant. Please select a size and try again.');
      return;
    }

    modalOrder.disabled    = true;
    modalOrder.textContent = 'Adding…';

    fetch('/cart/add.js', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id:       Number(shopifyVariantId),
        quantity: 1,
        properties: { '_design_url': currentDesignUrl }
      })
    })
    .then(function (r) {
      if (!r.ok) return r.json().then(function (d) { throw new Error(d.description || 'Cart error'); });
      window.location.href = '/cart';
    })
    .catch(function (err) {
      alert('Could not add to cart: ' + err.message);
      modalOrder.disabled    = false;
      modalOrder.textContent = 'Order This Design';
    });
  });

  function closeModal() {
    modal.classList.add('mockup-modal--hidden');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });
}());
</script>

<script src="{{ 'rise-shirt.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
