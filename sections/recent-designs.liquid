<section class="recent-designs-section section-padding">
  <div class="container">
    <h2 class="recent-designs__heading">Your Recent Designs</h2>
    <div id="recent-designs-container"></div>
  </div>
</section>

{% stylesheet %}
  .recent-designs__heading { margin-bottom: 1rem; font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text); margin-top: 0; }
  .recent-designs__scroll { overflow-x: auto; padding: 80px 0; margin: -80px 0; scrollbar-width: thin; scrollbar-color: var(--color-border) transparent; }
  .recent-designs__strip { display: flex; gap: 12px; }
{% endstylesheet %}

<script src="{{ 'recent-designs.js' | asset_url }}" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var container = document.getElementById('recent-designs-container');
  if (!container || !window.RecentDesigns) return;

  var fetchPromise;
  if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
    var now = Math.floor(Date.now() / 1000);
    var stubDesigns = [
      { id: 'stub-1', shader: 'rise-shirt',    mockupUrl: 'https://picsum.photos/seed/stub1/300/400', timestamp: now - 60,    values: {}, productHandle: 'rise-shirt' },
      { id: 'stub-2', shader: 'line-circle',   mockupUrl: 'https://picsum.photos/seed/stub2/300/400', timestamp: now - 3600,  values: {}, productHandle: 'line-circle' },
      { id: 'stub-3', shader: 'three-square',  mockupUrl: 'https://picsum.photos/seed/stub3/300/400', timestamp: now - 7200,  values: {}, productHandle: 'three-square' },
      { id: 'stub-4', shader: 'four-circles',  mockupUrl: 'https://picsum.photos/seed/stub4/300/400', timestamp: now - 86400, values: {}, productHandle: 'four-circles' },
      { id: 'stub-5', shader: 'chladni',       mockupUrl: 'https://picsum.photos/seed/stub5/300/400', timestamp: now - 172800,values: {}, productHandle: 'chladni' },
    ];
    fetchPromise = Promise.resolve(stubDesigns);
  } else {
    fetchPromise = RecentDesigns.fetchDesigns();
  }

  fetchPromise.then(function (designs) {
    RecentDesigns.renderFilmstrip(container, designs);
  });
});
</script>

{% schema %}
{
  "name": "Recent Designs",
  "settings": []
}
{% endschema %}
