{%- endif -%}
<script data-bf-analytics>
  (function () {
    var cfg = window.bfAnalyticsConfig || {};
    var enabled = !cfg.designMode;
    var sinks = [];
    var consentListeners = [];

    // Every event in the theme goes through here. A sink that throws (blocked
    // CDN, half-loaded vendor) must not take the other providers down with it.
    window.bfTrack = function (eventName, params) {
      for (var i = 0; i < sinks.length; i++) {
        try { sinks[i](eventName, params || {}); } catch (e) { /* analytics never breaks the page */ }
      }
    };

    function syncConsent(analyticsAllowed, marketingAllowed) {
      for (var i = 0; i < consentListeners.length; i++) {
        try { consentListeners[i](analyticsAllowed, marketingAllowed); } catch (e) { /* as above */ }
      }
    }

    // ── Google Analytics 4 ──────────────────────────────────────────────────
    if (enabled && cfg.ga4) {
      window.dataLayer = window.dataLayer || [];
      // Assigned, not declared: a `function gtag()` declaration inside this
      // block is block-scoped and the sink/listener below could not see it.
      window.gtag = function () { window.dataLayer.push(arguments); };

      // Default everything to denied. Shopify's native Customer Privacy API
      // (window.Shopify.customerPrivacy) is the CMP of record here — it
      // resolves each visitor's actual consent (banner choice, or "allowed"
      // by default in regions where consent isn't legally required) and we
      // mirror that into Consent Mode via the listener, instead of assuming
      // granted. https://shopify.dev/docs/api/customer-privacy
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied'
      });
      window.gtag('js', new Date());
      window.gtag('config', cfg.ga4);

      sinks.push(function (eventName, params) {
        window.gtag('event', eventName, params);
      });

      // Maps Shopify's consent categories onto Google's Consent Mode signals.
      // Shopify's "marketing" bucket covers ads/targeting, so it drives all
      // three ad_* signals; "analytics" drives analytics_storage.
      consentListeners.push(function (analyticsAllowed, marketingAllowed) {
        window.gtag('consent', 'update', {
          analytics_storage: analyticsAllowed ? 'granted' : 'denied',
          ad_storage: marketingAllowed ? 'granted' : 'denied',
          ad_user_data: marketingAllowed ? 'granted' : 'denied',
          ad_personalization: marketingAllowed ? 'granted' : 'denied'
        });
      });
    }

    // ── PostHog ─────────────────────────────────────────────────────────────
    // window.posthog is the loader stub above; absent (blocked, or not
    // configured) means every call here is skipped rather than thrown.
    if (enabled && cfg.posthogKey && window.posthog) {
      window.posthog.init(cfg.posthogKey, {
        api_host: String(cfg.posthogHost || 'https://us.i.posthog.com').replace(/\/+$/, ''),
        defaults: '2026-05-30',
        // Nothing is captured or stored until Shopify says analytics is
        // allowed. opt_out_persistence_by_default is the SDK's own
        // cookieless-until-consent switch: opt_in_capturing() below turns
        // capturing and persistence on together, and a returning consented
        // visitor (PostHog remembers its own grant) has persistence on from
        // init, so their first $pageview carries their persisted distinct_id
        // rather than a throwaway one.
        opt_out_capturing_by_default: true,
        opt_out_persistence_by_default: true,
        // PostHog's own consent marker lives in localStorage, not a cookie,
        // because the load-time sync below writes "denied" for every visitor
        // who hasn't consented — and that write must not set a cookie.
        opt_out_capturing_persistence_type: 'localStorage',
        disable_session_recording: true,
        capture_pageview: true,
        autocapture: true
      });

      sinks.push(function (eventName, params) {
        window.posthog.capture(eventName, params);
      });

      consentListeners.push(function (analyticsAllowed) {
        if (analyticsAllowed) {
          // Consent is re-synced on every page load, so the SDK's default
          // $opt_in event would fire once per page — suppress it. The SDK
          // captures the $pageview it deferred at init inside this call.
          window.posthog.opt_in_capturing({ captureEventName: null });
        } else {
          // Converges PostHog to Shopify's decision even when a revoke
          // happened on a page where array.js never loaded.
          window.posthog.opt_out_capturing();
        }
      });
    }

    if (!consentListeners.length) return;

    // window.Shopify.customerPrivacy isn't available until explicitly loaded —
    // checking for it directly (without loadFeatures) is always false this
    // early in page load, so the sync would silently never run.
    if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
      window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (error) {
        if (error) return;
        var privacy = window.Shopify.customerPrivacy;
        if (!privacy) return;
        // Returning visitors (or visitors outside a region requiring consent)
        // already have a resolved decision — apply it immediately rather than
        // waiting for visitorConsentCollected, which only fires when consent
        // changes, not on page load.
        syncConsent(!!privacy.analyticsProcessingAllowed(), !!privacy.marketingAllowed());
      });
    }

    // Fires whenever the shopper accepts/updates consent via Shopify's consent
    // banner (native or app-based) — keeps every provider in sync live.
    document.addEventListener('visitorConsentCollected', function (event) {
      var detail = (event && event.detail) || {};
      syncConsent(!!detail.analyticsAllowed, !!detail.marketingAllowed);
    });
  })();
</script>
