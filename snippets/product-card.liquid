<article class="product-card">
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}">
    <div class="product-card__media">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="product-card__image"
          loading="lazy"
          width="600"
          height="600"
        >
      {%- else -%}
        <div class="product-card__image product-card__image--placeholder"></div>
      {%- endif -%}
      <div class="product-card__glow" aria-hidden="true"></div>
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
      <p class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <s class="product-card__compare-price">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        <span>{{ product.price | money }}</span>
      </p>
    </div>
  </a>

  <div class="product-card__actions">
    {%- if product.variants.size == 1 -%}
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="btn btn--primary btn--sm"
          {% unless product.available %}disabled{% endunless %}
        >
          {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
      {%- endform -%}
    {%- else -%}
      <a href="{{ product.url }}" class="btn btn--primary btn--sm">Select Options</a>
    {%- endif -%}
    {%- if product.tags contains 'custom-design' -%}
      <a href="{{ product.url }}#shader" class="btn btn--outline btn--sm product-card__customize-btn">
        Customize Design
      </a>
    {%- endif -%}
  </div>
</article>
