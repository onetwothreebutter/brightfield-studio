{% doc %}
  Renders a product card with image, title, price, and add-to-cart or customize action.

  @param {product} product - The product to render
  @param {boolean} [enable_slider] - When true and the product has more than one image,
    renders all images as a click/swipe slider instead of just the featured image. The
    calling section must also include `assets/product-card-slider.js` for the arrows,
    dots, and swipe gestures to work.

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, enable_slider: true %}
{% enddoc %}

{%- assign new_cutoff = 'now' | date: '%s' | minus: 2592000 -%}
{%- assign published_at_unix = product.published_at | date: '%s' -%}
{%- assign is_new = false -%}
{%- if published_at_unix and published_at_unix >= new_cutoff -%}
  {%- assign is_new = true -%}
{%- endif -%}

{%- assign show_slider = false -%}
{%- if enable_slider and product.images.size > 1 -%}
  {%- assign show_slider = true -%}
  {%- assign slides = product.images | slice: 0, 6 -%}
{%- endif -%}

<article class="product-card">
  <div class="product-card__glow" aria-hidden="true"></div>

  {%- if show_slider -%}
    <div class="product-card__media-wrap" data-product-slider>
      <a href="{{ product.url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
        <div class="product-card__media">
          {%- if is_new -%}
            <span class="product-card__badge product-card__badge--new">New</span>
          {%- endif -%}
          {%- for image in slides -%}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | default: product.title | escape }}"
              class="product-card__image product-card__slide{% if forloop.first %} is-active{% endif %}"
              data-slide-index="{{ forloop.index0 }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {%- endfor -%}
        </div>
      </a>

      <button
        type="button"
        class="product-card__slider-arrow product-card__slider-arrow--prev"
        data-slider-prev
        aria-label="Previous image"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 4l-8 8 8 8"/>
        </svg>
      </button>
      <button
        type="button"
        class="product-card__slider-arrow product-card__slider-arrow--next"
        data-slider-next
        aria-label="Next image"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 4l8 8-8 8"/>
        </svg>
      </button>

      <div class="product-card__slider-dots">
        {%- for image in slides -%}
          <button
            type="button"
            class="product-card__slider-dot{% if forloop.first %} is-active{% endif %}"
            data-slider-dot
            data-slide-index="{{ forloop.index0 }}"
            aria-label="Show image {{ forloop.index }} of {{ slides.size }}"
          ></button>
        {%- endfor -%}
      </div>
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">
        <a href="{{ product.url }}" class="product-card__title-link">{{ product.title | escape }}</a>
      </h3>
      {%- render 'star-rating',
        average: product.metafields.custom.review_average.value,
        count: product.metafields.custom.review_count.value | default: 0,
        class: 'product-card__rating'
      -%}
      <p class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <s class="product-card__compare-price">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        <span>{{ product.price | money }}</span>
      </p>
    </div>
  {%- else -%}
    <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}">
      <div class="product-card__media">
        {%- if is_new -%}
          <span class="product-card__badge product-card__badge--new">New</span>
        {%- endif -%}
        {%- if product.featured_image -%}
          {{
            product.featured_image
            | image_url: width: 600
            | image_tag:
              alt: product.featured_image.alt,
              class: 'product-card__image',
              loading: 'lazy',
              width: 600,
              height: 600
          }}
        {%- else -%}
          <div class="product-card__image product-card__image--placeholder"></div>
        {%- endif -%}
      </div>

      <div class="product-card__info">
        <h3 class="product-card__title">{{ product.title | escape }}</h3>
        {%- render 'star-rating',
          average: product.metafields.custom.review_average.value,
          count: product.metafields.custom.review_count.value | default: 0,
          class: 'product-card__rating'
        -%}
        <p class="product-card__price">
          {%- if product.compare_at_price > product.price -%}
            <s class="product-card__compare-price">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
          <span>{{ product.price | money }}</span>
        </p>
      </div>
    </a>
  {%- endif -%}

  <div class="product-card__actions">
    {%- if product.variants.size == 1 -%}
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="btn btn--primary btn--sm"
          {% unless product.available %}disabled{% endunless %}
        >
          {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
      {%- endform -%}
    {%- else -%}
      <a href="{{ product.url }}" class="btn btn--primary btn--sm">View Details</a>
    {%- endif -%}
    {%- assign has_shader = false -%}
    {%- for tag in product.tags -%}
      {%- assign tag_prefix = tag | slice: 0, 7 -%}
      {%- if tag_prefix == 'shader-' -%}
        {%- assign has_shader = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if has_shader -%}
      <a href="{{ product.url }}#shader" class="btn btn--outline btn--sm product-card__customize-btn">
        Customize Design
      </a>
    {%- endif -%}
  </div>
</article>
