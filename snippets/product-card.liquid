{% doc %}
  Renders a product card with image, title, price, and add-to-cart or customize action.

  @param {product} product - The product to render

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- assign new_cutoff = 'now' | date: '%s' | minus: 2592000 -%}
{%- assign published_at_unix = product.published_at | date: '%s' -%}
{%- assign is_new = false -%}
{%- if published_at_unix and published_at_unix >= new_cutoff -%}
  {%- assign is_new = true -%}
{%- endif -%}

<article class="product-card">
  <div class="product-card__glow" aria-hidden="true"></div>
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}">
    <div class="product-card__media">
      {%- if is_new -%}
        <span class="product-card__badge product-card__badge--new">New</span>
      {%- endif -%}
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            alt: product.featured_image.alt,
            class: 'product-card__image',
            loading: 'lazy',
            width: 600,
            height: 600
        }}
      {%- else -%}
        <div class="product-card__image product-card__image--placeholder"></div>
      {%- endif -%}
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
      <p class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <s class="product-card__compare-price">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        <span>{{ product.price | money }}</span>
      </p>
    </div>
  </a>

  <div class="product-card__actions">
    {%- if product.variants.size == 1 -%}
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="btn btn--primary btn--sm"
          {% unless product.available %}disabled{% endunless %}
        >
          {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>
      {%- endform -%}
    {%- else -%}
      <a href="{{ product.url }}" class="btn btn--primary btn--sm">View Details</a>
    {%- endif -%}
    {%- assign has_shader = false -%}
    {%- for tag in product.tags -%}
      {%- assign tag_prefix = tag | slice: 0, 7 -%}
      {%- if tag_prefix == 'shader-' -%}
        {%- assign has_shader = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if has_shader -%}
      <a href="{{ product.url }}#shader" class="btn btn--outline btn--sm product-card__customize-btn">
        Customize Design
      </a>
    {%- endif -%}
  </div>
</article>
