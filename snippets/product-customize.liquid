{% doc %}
  The Customize panel for shader products: the control panel (filled in by
  assets/product-shader-gui.js) and the Preview on Shirt / Back actions.
  Render it wherever the controls should sit.

  @example
  {% render 'product-customize' %}
{% enddoc %}
<div class="shader-gui" id="shader-gui">
  <div class="shader-gui__mobile-bar">
    <button class="shader-gui__toggle" id="shader-gui-popout">Popout</button>
  </div>
  <p class="product-customize-hint">Adjust the controls to customize colors, patterns, and text — then use <em>Preview on Shirt</em> to see how it looks.</p>
  <div class="scroll-shadow scroll-shadow--top" aria-hidden="true"></div>
<div class="shader-gui__body" id="shader-gui-body"></div>
  <div class="scroll-shadow scroll-shadow--bottom" aria-hidden="true"></div>
</div>
<div class="shader-gui__preview">
  <button
    id="shader-preview-btn"
    class="btn btn--primary btn--lg btn--full"
    data-worker-url="https://brightfield-mockup-worker.eric-d-johnson.workers.dev"
    data-shirt-template="{{ 'shirt-template.png' | asset_url }}"
    data-print-area="0.30,0.165,0.40,0.45"
  >Preview on Shirt</button>
  <div class="shader-secondary-actions">
    <button class="shader-back-btn" data-tab="photo">← Back</button>
  </div>
  <p class="product-customize-actions__note">You'll select your size when you order.</p>
</div>
