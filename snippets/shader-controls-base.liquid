function toHex(v) {
  return '#' + v.map(function (x) {
    var b = Math.round(Math.max(0, Math.min(1, x)) * 255).toString(16);
    return b.length === 1 ? '0' + b : b;
  }).join('');
}

function applyColors(keyValPairs) {
  keyValPairs.forEach(function (pair) {
    window._shaderState.values[pair[0]] = pair[1];
    var inp = document.querySelector('[data-param-key="' + pair[0] + '"]');
    if (inp) {
      inp.value = toHex(pair[1]);
      inp.dispatchEvent(new Event('input', { bubbles: true }));
    }
  });
}

