var customAfterBuild = function () {
  var cosineKeys = ['u_a', 'u_b', 'u_c', 'u_d'];

  function applyCosinePreset(p) {
    applyColors(cosineKeys.map(function (k, i) {
      return [k, [p.a, p.b, p.c, p.d][i]];
    }));
  }

  function apply4ColorPreset(p) {
    applyColors([
      ['u_color0', p.c0],
      ['u_color1', p.c1],
      ['u_color2', p.c2],
      ['u_color3', p.c3],
    ]);
  }

  // Apply default on load so shader matches pickers.
  applyCosinePreset(COSINE_PRESETS['Rainbow']);

  var cosinePresetSel = document.querySelector('[data-param-key="_rtr_palette_preset"]');
  if (cosinePresetSel) {
    cosinePresetSel.addEventListener('change', function () {
      var p = COSINE_PRESETS[this.value];
      if (p) applyCosinePreset(p);
    });
  }

  var fourColorPresetSel = document.querySelector('[data-param-key="_rtr_4color_preset"]');
  if (fourColorPresetSel) {
    fourColorPresetSel.addEventListener('change', function () {
      var p = FOUR_STOP_PRESETS[this.value];
      if (p) apply4ColorPreset(p);
    });
  }

  // Toggle-driven row visibility. The GUI builder's *Dependent flags are
  // hard-coded per shader, so drive these two locally: find the toggle row by
  // its label and hide the N rows that follow it.
  var body = document.getElementById('shader-gui-body');

  // Label text lives in the first child node — a trailing tip button ('?') is
  // appended after it, so textContent alone would not match.
  function labelText(el) {
    var lbl = el.querySelector && el.querySelector('.shader-control__label');
    if (!lbl || !lbl.firstChild) return '';
    return (lbl.firstChild.textContent || '').trim();
  }

  function bindToggleVisibility(toggleLabel, rowCount) {
    var rows = Array.from(body.children);
    var toggleRow = rows.find(function (el) {
      return labelText(el) === toggleLabel && el.querySelector('.shader-control__toggle');
    });
    if (!toggleRow) return;
    var btn = toggleRow.querySelector('.shader-control__toggle');

    var dependents = [];
    var idx = rows.indexOf(toggleRow) + 1;
    while (idx < rows.length && dependents.length < rowCount) {
      var el = rows[idx];
      if (el.classList.contains('shader-control__section-header')) break;
      if (el.classList.contains('shader-control')) dependents.push(el);
      idx++;
    }

    function apply() {
      var on = btn.dataset.on === '1';
      dependents.forEach(function (r) { r.style.display = on ? '' : 'none'; });
    }
    btn.addEventListener('click', apply);
    // Share-link restore and undo set data-on directly instead of clicking, so
    // watch the attribute too rather than relying on the click event alone.
    new MutationObserver(apply).observe(btn, { attributes: true, attributeFilter: ['data-on'] });
    apply();
  }

  bindToggleVisibility('Custom Ring Color', 1);
  bindToggleVisibility('Custom Inner Color', 1);
};
