var customAfterBuild = function () {
  var cosineKeys = ['u_a', 'u_b', 'u_c', 'u_d'];

  function applyCosinePreset(p) {
    applyColors(cosineKeys.map(function (k, i) {
      return [k, [p.a, p.b, p.c, p.d][i]];
    }));
  }

  function apply4ColorPreset(p) {
    applyColors([
      ['u_color0', p.c0],
      ['u_color1', p.c1],
      ['u_color2', p.c2],
      ['u_color3', p.c3],
    ]);
  }

  // Apply default on load so shader matches pickers.
  applyCosinePreset(COSINE_PRESETS['Rainbow']);

  var cosinePresetSel = document.querySelector('[data-param-key="_rtr_palette_preset"]');
  if (cosinePresetSel) {
    cosinePresetSel.addEventListener('change', function () {
      var p = COSINE_PRESETS[this.value];
      if (p) applyCosinePreset(p);
    });
  }

  var fourColorPresetSel = document.querySelector('[data-param-key="_rtr_4color_preset"]');
  if (fourColorPresetSel) {
    fourColorPresetSel.addEventListener('change', function () {
      var p = FOUR_STOP_PRESETS[this.value];
      if (p) apply4ColorPreset(p);
    });
  }

  // Toggle-driven row visibility. The GUI builder's *Dependent flags are
  // hard-coded per shader, so drive these two locally — keyed off param keys,
  // same lookup test-shaders.html uses.
  var body = document.getElementById('shader-gui-body');

  function bindToggleVisibility(toggleKey, colorKey) {
    var btn    = body.querySelector('[data-param-key="' + toggleKey + '"]');
    var picker = body.querySelector('[data-param-key="' + colorKey + '"]');
    if (!btn || !picker) return;
    var row = picker.closest('.shader-control');
    if (!row) return;

    function apply() { row.style.display = btn.dataset.on === '1' ? '' : 'none'; }
    btn.addEventListener('click', apply);
    // Randomize and the restore paths set data-on directly instead of clicking,
    // so watch the attribute too rather than relying on the click event alone.
    new MutationObserver(apply).observe(btn, { attributes: true, attributeFilter: ['data-on'] });
    apply();
  }

  bindToggleVisibility('u_use_ring_color', 'u_ring_color');
  bindToggleVisibility('u_use_inner_color', 'u_inner_color');
};
