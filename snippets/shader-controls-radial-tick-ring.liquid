  { type: 'header', label: 'Ring' },
  // The design space is (uv - 0.5) * vec2(aspect, 1.0), so on the 3:4 canvas the
  // horizontal half-extent is aspect/2 = 0.375 while the vertical one is 0.5 — a
  // circle past 0.375 runs off the left and right edges only. Ticks straddle the
  // radius, so the ring closes when radius + tickLength * majorScale / 2 <= 0.375.
  // 0.33 with the default 0.05 length and 1.8 major scale lands exactly on that
  // limit: the major tips graze the side edges without any chord being cut off.
  // Larger values are still useful (a full-bleed cropped ring), just not a circle.
  { key: 'u_ring_radius',      label: 'Ring Radius',       type: 'range', min: 0.05,  max: 0.5,  step: 0.01,  value: 0.33, noRandomize: true,
    tip: 'Above about 0.33 the ring runs off the left and right edges — the canvas is taller than it is wide.' },
  { key: 'u_tick_count',       label: 'Tick Count',        type: 'range', min: 4,     max: 180,  step: 1,     value: 48 },
  { key: 'u_tick_length',      label: 'Tick Length',       type: 'range', min: 0.005, max: 0.25, step: 0.005, value: 0.05 },
