{% if customer and customer.id == 323557855 %}
<div class="community-admin" id="community-admin">
  <div class="community-admin__panel" id="community-admin-panel">
    <div class="community-admin__tabs">
      <button class="community-admin__tab community-admin__tab--active" data-tab="pending">Pending</button>
      <button class="community-admin__tab" data-tab="approved">Approved</button>
      <button class="community-admin__tab" data-tab="rejected">Rejected</button>
    </div>
    <div id="community-admin-content" class="community-admin__content"></div>
  </div>
</div>

<style>
.community-admin { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
.community-admin__heading { font-size: 1.25rem; margin-bottom: 1rem; }
.community-admin__tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem; }
.community-admin__tab {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 0.3rem 0.8rem;
  font-size: 0.75rem;
  color: var(--color-text);
  cursor: pointer;
}
.community-admin__tab--active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #000;
}
.community-admin__cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
.community-admin__card { border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; }
.community-admin__card-img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; }
.community-admin__card-info { padding: 0.5rem; font-size: 0.7rem; color: var(--color-text); }
.community-admin__card-info strong { display: block; font-size: 0.75rem; margin-bottom: 0.2rem; }
.community-admin__card-info em { color: var(--color-text-muted); font-style: normal; font-size: 0.65rem; }
.community-admin__card-actions { display: flex; gap: 0.35rem; padding: 0 0.5rem 0.5rem; }
.community-admin__empty { color: var(--color-text-muted); font-size: 0.8rem; padding: 1rem 0; }
</style>

<script>
(function () {
  var WORKER_URL = 'https://brightfield-mockup-worker.eric-d-johnson.workers.dev';
  var adminToken = {{ settings.community_admin_token | json }};
  var currentTab = 'pending';

  var content = document.getElementById('community-admin-content');
  var tabs     = document.querySelectorAll('.community-admin__tab');

  function authHeaders() {
    return { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' };
  }

  function timeAgo(timestamp) {
    var diff = Math.floor((Date.now() - timestamp * 1000) / 1000);
    if (diff < 60) return diff + 's ago';
    if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
    return Math.floor(diff / 86400) + 'd ago';
  }

  function loadTab(tab) {
    currentTab = tab;
    content.innerHTML = '<p style="font-size:0.8rem;color:var(--color-text-muted)">Loading…</p>';

    var endpoint = tab === 'pending' ? '/community/pending' : '/community/list?status=' + tab;
    fetch(WORKER_URL + endpoint, { headers: authHeaders() })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (designs) { renderCards(designs, tab); })
      .catch(function (err) {
        content.innerHTML = '<p class="community-admin__empty">Error loading designs: ' + err.message + '</p>';
      });
  }

  function renderCards(designs, tab) {
    if (!designs || !designs.length) {
      content.innerHTML = '<p class="community-admin__empty">No ' + tab + ' designs.</p>';
      return;
    }

    var grid = document.createElement('div');
    grid.className = 'community-admin__cards';

    designs.forEach(function (d) {
      var card = document.createElement('div');
      card.className = 'community-admin__card';

      var img = document.createElement('img');
      img.src = d.mockupUrl;
      img.alt = 'Design by ' + (d.creatorName || 'Unknown');
      img.className = 'community-admin__card-img';
      img.loading = 'lazy';

      var info = document.createElement('div');
      info.className = 'community-admin__card-info';
      info.innerHTML =
        '<strong>' + escHtml(d.creatorName || 'Anonymous') + '</strong>' +
        '<em>' + escHtml(d.creatorEmail || '') + '</em><br>' +
        '<em>' + escHtml((d.shader || '').replace(/-/g, ' ')) + ' &middot; ' + timeAgo(d.timestamp) + '</em>';

      card.appendChild(img);
      card.appendChild(info);

      if (tab === 'pending') {
        var actions = document.createElement('div');
        actions.className = 'community-admin__card-actions';

        var approveBtn = document.createElement('button');
        approveBtn.className = 'btn btn--primary btn--sm';
        approveBtn.style.flex = '1';
        approveBtn.textContent = 'Approve';

        var rejectBtn = document.createElement('button');
        rejectBtn.className = 'btn btn--outline btn--sm';
        rejectBtn.style.flex = '1';
        rejectBtn.textContent = 'Reject';

        (function (id, aBtn, rBtn) {
          aBtn.addEventListener('click', function () { moderateDesign(id, 'approve', card); });
          rBtn.addEventListener('click', function () { moderateDesign(id, 'reject', card); });
        }(d.id, approveBtn, rejectBtn));

        actions.appendChild(approveBtn);
        actions.appendChild(rejectBtn);
        card.appendChild(actions);
      }

      grid.appendChild(card);
    });

    content.innerHTML = '';
    content.appendChild(grid);
  }

  function moderateDesign(id, action, cardEl) {
    fetch(WORKER_URL + '/community/' + action, {
      method:  'POST',
      headers: authHeaders(),
      body:    JSON.stringify({ id: id })
    })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        cardEl.style.opacity = '0.3';
        cardEl.style.pointerEvents = 'none';
      })
      .catch(function (err) { alert('Action failed: ' + err.message); });
  }

  function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.remove('community-admin__tab--active'); });
      tab.classList.add('community-admin__tab--active');
      loadTab(tab.dataset.tab);
    });
  });

  loadTab('pending');
}());
</script>
{% else %}
<p style="padding:2rem">Access denied. <a href="/account/login">Log in</a> to continue.</p>
{% endif %}
